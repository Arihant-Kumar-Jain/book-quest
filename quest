    ./quest read [2.3 | 2 | 2.all]  mark reading done (no arg = the next one)
    ./quest stop ["note"]        end the timer; writes a session summary to journal.md
    ./quest review [n] [ch3]     flashcards (Q:/A: lines) from your notes.md files

  {B('Look around')}
    ./quest world [--ipad]       the clickable world map in your browser; --ipad adds the iPad reader
    ./quest map                  every chapter + boss
    ./quest ch [n]               one chapter: reading quests, exercises, files
    ./quest boss [n]             list bosses / fight one
    ./quest badges · stats       achievements · XP breakdown + 12-week heatmap
    ./quest pdf [key]            open the book (or a side book)

  {B('Side quests')}  (optional books: XP + streak days, never required)
    ./quest side [key]           list side books / one book's quests and labs
    ./quest read KEY | KEY.2     next quest in a side book / in its chapter 2

  {B('Exercises')}  (books with "code" in book.json: C++, C, Python, JavaScript or your own commands)
    ./quest run 2-1 [-- args]    build + run an exercise (or bossN, or any source path)
    ./quest done 2-1 ["note"]    check and claim an exercise (0 warnings = +{XP_CLEAN} bonus); non-code tasks just count

  {B('Housekeeping')}
    ./quest log "text"           add a line to journal.md
    ./quest undo [id]            undo the last action (or the last one for an id)
    ./quest goal 150             change the daily XP goal (default {DEFAULT_GOAL})

  C/C++ flags: --asan (AddressSanitizer+UBSan), --tsan (ThreadSanitizer), --force (skip the compile check)
"""


def cmd_help(book, args):
    print(HELP)


COMMANDS = {
    "status": cmd_status, "s": cmd_status, "next": cmd_status,
    "read": cmd_read, "r": cmd_read,
    "run": cmd_run, "done": cmd_done, "d": cmd_done,
    "boss": cmd_boss, "start": cmd_start, "stop": cmd_stop, "log": cmd_log,
    "review": cmd_review, "ch": cmd_ch, "chapter": cmd_ch, "map": cmd_map,
    "badges": cmd_badges, "stats": cmd_stats, "undo": cmd_undo, "goal": cmd_goal,
    "init": cmd_init, "pdf": cmd_pdf, "side": cmd_side, "world": cmd_world, "w": cmd_world, "help": cmd_help, "-h": cmd_help, "--help": cmd_help,
}


def welcome():
    pdfs = sorted(p.name for p in ROOT.glob("*.pdf"))
    print(f"\n  ⚔  {B('Welcome to quest.')} Turn any book into a game you play while you read it.\n")
    if pdfs:
        print(f"  Found {len(pdfs)} PDF{'s' if len(pdfs) > 1 else ''} here. Start your quest with:\n")
        print(f"     ./quest add {shlex.quote(pdfs[0])}\n")
    else:
        print("  1. Put your book's PDF in this folder (any PDF you own).")
        print("  2. Run:  ./quest add \"Your Book.pdf\"\n")
    print(DIM("  It reads the table of contents and builds chapters, reading quests and boss fights.\n"
              "  ./quest help shows every command.\n"))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    if cmd == "add":
        return cmd_add(args[1:])
    if cmd not in COMMANDS:
        print(RED(f"  Unknown command '{cmd}'."))
        cmd_help(None, [])
        sys.exit(1)
    if not BOOK_FILE.exists() and cmd not in ("help", "-h", "--help"):
        return welcome()
    book = Book()
    COMMANDS[cmd](book, args[1:])


if __name__ == "__main__":
    main()
