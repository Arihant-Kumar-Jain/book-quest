PAIR_FILE = QDIR / "pair.key"


def pair_key():
    """The iPad pairing secret, kept across restarts so you only scan the QR code once."""
    import secrets
    if PAIR_FILE.exists():
        k = PAIR_FILE.read_text().strip()
        if len(k) >= 12:
            return k
    k = secrets.token_urlsafe(12)
    PAIR_FILE.write_text(k + "\n")
    os.chmod(PAIR_FILE, 0o600)
    return k


