            print(f"\n  {B(GRN('📗 SIDE QUEST COMPLETE'))} · {s['title']}  {YEL('+' + str(s['xp']) + ' XP')}")
            log.append(f"- 📗 {now():%H:%M} · **Finished side quest: {s['title']}**")
    for bid in b.badges:
        if bid not in a.badges or bid not in save["badge_dates"]:
            if bid not in save["badge_dates"]:
