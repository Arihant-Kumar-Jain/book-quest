                     "labs": [ex(s, x) for x in s["labs"]]})
    nr = next_read(book, save, k)
    nxt = {"read": dict(rq(nr[1]), ch=nr[0]["num"]) if nr else None, "ex": None}
    if k.current is not None:
        c = book.ch[k.current]
        todo = [e for e in Book.required_ex(c) if e["id"] not in k.exd]
        if todo:
            nxt["ex"] = dict(ex(c, todo[0]), ch=c["num"])
    recent = [{"at": at, "xp": xp, "label": label} for at, xp, kind, label in k.ledger if kind not in ("streak", "goal")][-14:]
    return {
