def notes_lines(book, c):
    p = ROOT / c["dir"] / "notes.md"
    if not p.exists():
        return 0
    tmpl = {ln.strip() for ln in (side_notes_template(c) if "key" in c else notes_template(c)).splitlines()}
    n = 0
    for ln in p.read_text(encoding="utf-8", errors="replace").splitlines():
        s = ln.strip()
        if s and s not in tmpl and s not in ("-", "Q:", "A:") and not s.startswith("<!--"):
            n += 1
    return n


