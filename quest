# ───────────────────────────── building + running code ─────────────────────────────
# A book picks its language with "code" in book.json: a preset name, or its own commands, e.g.
#   "code": {"ext": [".rs"], "build": ["rustc", "{main}", "-o", "{out}"], "run": ["{out}"]}
# {sources} expands to every source file, {main} is main.* (or the only file), {out} is the build output.
CODE_PRESETS = {
    "cpp": {"lang": "cpp", "ext": [".cpp", ".cc"], "headers": [".h", ".hpp"], "listings": True},
    "c": {"lang": "c", "ext": [".c"], "headers": [".h"], "listings": True},
    "python": {"ext": [".py"], "check": ["{python}", "-m", "py_compile", "{sources}"], "run": ["{python}", "{main}"]},
    "javascript": {"ext": [".js", ".mjs"], "check": ["node", "--check", "{main}"], "run": ["node", "{main}"]},
}
PREFIXES = [Path("/opt/homebrew"), Path("/usr/local")]


LINUX = sys.platform.startswith("linux")


def boost_available():
    return any((p / "include" / "boost").is_dir() for p in PREFIXES + [Path("/usr")])


def boost_hint():
    return "sudo apt install libboost-dev libboost-program-options-dev" if LINUX else "brew install boost"


def opener():
    return "open" if sys.platform == "darwin" else ("xdg-open" if shutil.which("xdg-open") else None)


def code_exts():
    c = _BOOK.code if _BOOK else None
    return tuple(c["ext"]) if c else ()


def build(sources, out_name, sanitize=None):
    """Compile or check code. → (ok, warning count, command that runs the program or None)."""
    code = _BOOK.code
    if not code:
        die('This book has no code setup. Add "code": "cpp" (or "c", "python", "javascript") to .quest/book.json.')
    if code.get("lang") in ("cpp", "c"):
        ok, warns, out = build_native(code["lang"], sources, out_name, sanitize)
        return ok, warns, [str(out)]
    BUILD.mkdir(exist_ok=True)
    main = next((s for s in sources if s.stem == "main"), sources[0])

    def fill(tpl):
        out = []
        for t in tpl:
            if t == "{sources}":
                out += [rel(x) for x in sources]
            else:
                out.append(t.format(main=rel(main), out=rel(BUILD / out_name), python=sys.executable))
        return out
    run = fill(code["run"]) if code.get("run") else None
    step = code.get("build") or code.get("check")
    if not step:
        return True, 0, run
    cmd = fill(step)
    if not shutil.which(cmd[0]):
        die(f"'{cmd[0]}' isn't installed (needed to check {code['ext'][0]} files).")
    print(DIM("  $ " + " ".join(shlex.quote(x) for x in cmd)))
    sys.stdout.flush()
    p = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT)
    text = (p.stdout + p.stderr).rstrip()
    if text:
        print(textwrap.indent(text, "  "))
    return p.returncode == 0, len(re.findall(r"\bwarning\b", text, re.I)), run


def build_native(lang, sources, out_name, sanitize=None):
    cxx = os.environ.get("CXX" if lang == "cpp" else "CC", "clang++" if lang == "cpp" else "clang")
    if not shutil.which(cxx):
        die(f"Compiler '{cxx}' not found. " + ("Install it: sudo apt install build-essential" if LINUX
                                                 else "Install the Xcode command-line tools: xcode-select --install"))
    BUILD.mkdir(exist_ok=True)
    out = BUILD / out_name
    std = "-std=c++20" if lang == "cpp" else "-std=c17"
    cmd = [cxx, std, "-Wall", "-Wextra", "-g"]
    for p in PREFIXES:
        if (p / "include").is_dir():
            cmd += ["-isystem", str(p / "include")]
        if (p / "lib").is_dir():
            cmd += ["-L", str(p / "lib")]
    if sanitize == "asan":
        cmd += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
    elif sanitize == "tsan":
        cmd += ["-fsanitize=thread"]
    extra = []
    for s in sources:
        for m in re.finditer(r"//\s*quest-flags:\s*(.+)$", s.read_text(encoding="utf-8", errors="replace"), re.M):
            extra += shlex.split(m.group(1))
    srcs = [rel(s) for s in sources]           # relative paths → short, clickable diagnostics
    cmd += srcs + extra + ["-o", rel(out)]
    short = [cxx, std, "-Wall", "-Wextra", "-g"] + \
            (["-fsanitize=" + ("address,undefined" if sanitize == "asan" else "thread")] if sanitize else []) + \
            srcs + extra + ["-o", rel(out)]
    print(DIM("  $ " + " ".join(shlex.quote(x) for x in (cmd if os.environ.get("QUEST_VERBOSE") else short))))
    sys.stdout.flush()
    p = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT)
    text = (p.stdout + p.stderr).rstrip()
    warnings = len(re.findall(r"\bwarning:", text))
    if text:
        print(textwrap.indent(text, "  "))
    if p.returncode != 0 and "boost/" in text and not boost_available():
        print(YEL(f"  Boost isn't installed. Run: {boost_hint()}"))
    return p.returncode == 0, warnings, out


def sources_in(path):
    exts = code_exts()
    if path.is_dir():
        return sorted(f for f in path.rglob("*") if f.suffix in exts and "tests" not in f.relative_to(path).parts)
    return [path] if path.exists() else []


def resolve_target(book, target):
    """→ (label, sources, out_name). target: exercise id, bossN, or a path to a source file/folder."""
    if target in book.ex:
        c, e = book.ex[target]
        if not e["file"]:
            die(f"{target} is a {e['kind']} task, not code. Mark it with: ./quest done {target}")
        p = book.ex_path(c, e)
        return f"exercise {target}", sources_in(p), p.stem if p.is_file() else p.name
    m = re.fullmatch(r"(?:boss|b)(\d+)", target)
    if m and int(m.group(1)) in book.bosses:
        b = book.bosses[int(m.group(1))]
        return f"boss {b['n']}", sources_in(book.boss_dir(b)), b["dir"]
    for base in (Path.cwd(), ROOT):
        p = (base / target)
        if p.exists():
            return rel(p), sources_in(p), p.stem if p.is_file() else p.name
    die(f"Don't know '{target}'. Use an exercise id (2-1), boss3, or a path to a source file or folder.")


