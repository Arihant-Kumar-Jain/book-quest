        if a in ("--title", "--short", "--key", "--pages", "--ai-pages", "--offset", "--model") and i + 1 < len(args):
            opts[a[2:]] = args[i + 1]
            i += 2
            continue
        if a not in flags:
            rest.append(a)
        i += 1
    if len(rest) != 1:
        die('Usage: ./quest add <book.pdf> [--side] [--title "Full Title"] [--short "Short Name"] [--dry-run]\n'
            '         [--ai [--ai-pages 40] [--offset N] [--model claude-opus-5-5]]')
