def unit_for_page(book, key, pg):
    """→ (chapter or side book, reading quest) that PDF page `pg` belongs to, for its notes.md."""
    def span(q):
        lo = q.get("pdf", q["page"])
        return (lo, q["end"]) if isinstance(lo, int) and isinstance(q["end"], int) else (None, None)
    if key in (None, "", "main"):
        for c in book.chapters:
            for q in c["reading"]:
                lo, hi = span(q)
                if lo is not None and lo <= pg <= hi:
                    return c, q
        before = [c for c in book.chapters if c["reading"] and (span(c["reading"][0])[0] or 0) <= pg]
        return (before[-1] if before else book.chapters[0]), None
    s_ = book.side.get(key)
    if not s_:
        return None, None
    for sc in s_["chapters"]:
        for q in sc["reading"]:
            lo, hi = span(q)
            if lo is not None and lo <= pg <= hi:
                return s_, q
    return s_, None


def clean_strokes(strokes):
    """Keep only well-formed strokes: pen or highlighter, a color, a width, and [x, y, pressure] points in 0..1."""
    out = []
    if not isinstance(strokes, list):
        return None
    for st in strokes[:3000]:
        if not isinstance(st, dict) or st.get("t") not in ("pen", "hl") or not isinstance(st.get("pts"), list):
            return None
        c = str(st.get("c") or "#111111")[:9]
        w = st.get("w")
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", c) or not isinstance(w, (int, float)) or not 0 < w < 0.1:
            return None
        pts = []
        for pt in st["pts"][:6000]:
            if not (isinstance(pt, list) and len(pt) == 3 and all(isinstance(v, (int, float)) for v in pt)):
                return None
            pts.append([round(min(1.2, max(-0.2, pt[0])), 5), round(min(1.2, max(-0.2, pt[1])), 5), round(min(1, max(0, pt[2])), 3)])
        if pts:
            out.append({"t": st["t"], "c": c, "w": round(w, 5), "pts": pts})
    return out
