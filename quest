BENCH_DIR = ROOT / "bench"
BENCH_W, BENCH_H = 1608, 2328            # an iPad-sized page box nobody else draws at, so "cold" is truly cold


def _pct(xs, q):
    xs = sorted(x for x in xs if x is not None)
    if not xs:
        return None
    k = (len(xs) - 1) * q
    lo = int(k)
    hi = min(lo + 1, len(xs) - 1)
    return xs[lo] + (xs[hi] - xs[lo]) * (k - lo)


def _stats(xs):
    xs = [x for x in xs if x is not None]
    return {"n": len(xs), "p50": _pct(xs, .5), "p90": _pct(xs, .9), "p95": _pct(xs, .95), "p99": _pct(xs, .99),
            "min": min(xs) if xs else None, "max": max(xs) if xs else None}


def _f(v, unit="ms", nd=2):
    if v is None:
        return "—"
    if unit == "KB":
        return f"{v / 1024:,.1f} KB"
    if unit == "µs":
        return f"{v * 1000:,.0f} µs"
    return f"{v:,.{nd}f} ms"


def machine_info():
    import platform

    def sysctl(k):
        try:
            return subprocess.run(["sysctl", "-n", k], capture_output=True, text=True, timeout=3).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""
    return {"cpu": sysctl("machdep.cpu.brand_string") or platform.processor(), "cores": int(sysctl("hw.ncpu") or 0),
            "performance_cores": sysctl("hw.perflevel0.physicalcpu"), "efficiency_cores": sysctl("hw.perflevel1.physicalcpu"),
            "memory_gb": round(int(sysctl("hw.memsize") or 0) / 2 ** 30), "macos": platform.mac_ver()[0],
            "python": platform.python_version(), "date": iso(now())}


def bench_engine(pdf, n, quick):
    """The Swift helper times every stage itself (B command) and checks every PNG decodes pixel-exact."""
    r = PageRenderer(workers=1)
    if not r.available():
        die("The native renderer isn't available here (it needs macOS with swiftc).")
    count = 12 if quick else 48
    pages = sorted({max(1, min(n, round(1 + i * (n - 1) / (count - 1)))) for i in range(count)})
    rounds = 1 if quick else 3
    best = {}
    for rnd in range(rounds):
        for i in range(0, len(pages), 8):
            chunk = pages[i:i + 8]
            body, _ = r._call(f"B\t{pdf}\t{BENCH_W}\t{BENCH_H}\t{','.join(map(str, chunk))}\t8")
            d = json.loads(body)
            for row in d["rows"]:
                prev = best.get(row["page"])
                if prev is None:
                    best[row["page"]] = row
                else:                                    # best of N rounds for timings; sizes are identical
                    for k_, v in row.items():
                        if k_.endswith("_ms") and isinstance(v, (int, float)):
                            prev[k_] = min(prev[k_], v)
            print(DIM(f"    engine: round {rnd + 1}/{rounds}, {min(i + 8, len(pages))}/{len(pages)} pages"), end="\r")
    print(" " * 60, end="\r")
    rows = list(best.values())
    text = [x for x in rows if not x["color"] and x["midtones"] < 0.12]
    col = lambda k, rs=None: [x[k] for x in (rs if rs is not None else text) if k in x]
    out = {"pages": len(rows), "text_pages": len(text), "rounds": rounds, "box": [BENCH_W, BENCH_H],
           "page_px": [text[0]["w"], text[0]["h"]] if text else None, "neon": d.get("neon"), "cores": d.get("cores")}
    out["codecs"] = {name: {"bytes": _stats(col(name + "_bytes")), "ms": _stats(col(name + "_ms"))}
                     for name in ("png4_neon_n", "jpeg_color", "jpeg_gray", "heic", "png_gray8", "preview")}
    out["stages"] = {k_: _stats(col(k_)) for k_ in (
        "draw_ms", "color_check_ms", "draw_rgb_ms", "gray_color_pass_ms", "midtones_ms",
        "png4_scalar_1_pack_ms", "png4_neon_1_pack_ms", "png4_neon_n_pack_ms",
        "png4_neon_1_deflate_ms", "png4_neon_n_deflate_ms",
        "png4_scalar_1_ms", "png4_neon_1_ms", "png4_neon_n_ms", "first_render_ms", "repeat_render_ms")}
    out["scaling"] = {c: _stats(col(f"scale_{c}_ms")) for c in (1, 2, 4, 8)}
    out["mismatched_pixels"] = sum(x.get(k_, 0) for x in rows for k_ in x if k_.endswith("mismatched_pixels"))
    out["verified_pixels"] = sum(x["w"] * x["h"] * 3 for x in rows)
    return out


