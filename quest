def cmd_stop(book, args):
    mins_override = None
    if "-m" in args:
        i = args.index("-m")
        try:
            mins_override = int(args[i + 1])
        except (IndexError, ValueError):
            die("Usage: ./quest stop [-m minutes] [\"note\"]")
        args = args[:i] + args[i + 2:]
    note = " ".join(args).strip()

    def fn(save):
        if not save["session"]:
            die("No session running. Start one with ./quest start")
        st = datetime.fromisoformat(save["session"]["start"])
        end = now()
        mins = mins_override if mins_override is not None else int((end - st).total_seconds() // 60)
        if mins > SESSION_CAP_MIN:
            print(YEL(f"  That's {mins} min; did you forget to stop? Capped at {SESSION_CAP_MIN}. Use -m N to set it exactly."))
            mins = SESSION_CAP_MIN
        save["session"] = None
        save["events"].append({"t": "session", "start": iso(st), "min": mins, "at": iso(end)})
        during = [e for e in save["events"] if iso(st) <= e["at"] <= iso(end) and e["t"] in ("read", "ex", "boss", "review")]
        reads = [e["id"] for e in during if e["t"] == "read"]
        exs = [e["id"] for e in during if e["t"] == "ex"]
        lines = [f"### ⏱️ {st:%H:%M}–{end:%H:%M} · {mins} min focus session"]
        if reads:
            lines.append("- 📖 Read " + ", ".join(f"{i} {book.reading[i][1]['title']}" for i in reads))
        if exs:
            lines.append("- ⚔️ Completed " + ", ".join(f"{i} {book.ex[i][1]['title']}" for i in exs))
        for e in during:
            if e["t"] == "boss":
                lines.append(f"- 🐉 Defeated boss {e['n']}")
            if e["t"] == "review":
                lines.append(f"- ♻️ Reviewed {e['n']} flashcards ({e['ok']} ✓)")
        if note:
            lines.append(f"- 💬 {note}")
        journal_append(["", *lines, ""])
        xp = min(SESSION_CAP_XP, mins) if mins >= SESSION_MIN else 0
        print(f"  ⏱️  {mins} min logged  {YEL('+' + str(xp) + ' XP') if xp else DIM('(sessions under ' + str(SESSION_MIN) + ' min earn no XP)')}"
              f"  · summary written to journal.md")
        if not note:
            print(DIM("  Tip: ./quest stop \"what clicked today\" adds a note to the journal."))
    _, k = mutate(book, fn)
    mini(k)


