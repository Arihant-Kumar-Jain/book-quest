    if b["n"] in k.boss:
        return f"Defeated {k.boss[b['n']][:10]}"
    if boss_unlocked(k, b):
        return "Ready to fight!"
    return "Locked · clear ch " + ", ".join(str(n) for n in b["unlock"] if not k.chap[n].cleared)


