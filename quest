            log.append(f"- 🏰 {now():%H:%M} · **{name} complete!**")
    s_new = set(b.scribe) - set(a.scribe)
    for ch in sorted(s_new, key=str):
        print(f"  📜 Notes bonus for {unit_name(book, ch)}: your notes.md is filling up nicely. {YEL('+' + str(XP_SCRIBE) + ' XP')}")
    for key, v in b.side.items():
