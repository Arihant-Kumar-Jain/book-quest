def local_addresses():
    """Every IPv4 address another device could use to reach this machine, as (label, ip)."""
    out = []
    try:
        r = subprocess.run(["ifconfig"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return out
    iface = None
    for ln in r.stdout.splitlines():
        m = re.match(r"^([a-z][a-z0-9]*):", ln)
        if m:
            iface = m.group(1)
            continue
        m = re.match(r"\s+inet (\d+\.\d+\.\d+\.\d+)", ln)
        if not (m and iface) or m.group(1).startswith(("127.", "169.254.")):
            continue
        ip = m.group(1)
        if ip.startswith("172.20.10."):
            label = "Personal Hotspot (cable or Wi-Fi)"
        elif iface == "en0":
            label = "Wi-Fi"
        elif iface.startswith(("bridge", "utun", "awdl", "llw", "anpi")):
            continue
        else:
            label = f"network {iface}"
        out.append((label, ip))
    return out


def lan_ip():
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))  # picks the outgoing interface; no packet is sent
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "127.0.0.1"


