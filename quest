PART_EMOJI = ["🏰", "🌐", "🗻", "🌋", "🏯", "🌊", "🌲", "🏜️"]


def part_badges(book):
    """One badge per part of the book (only for books with parts)."""
    out = []
    for i, (p, nums) in enumerate(book.parts.items()):
        name = book.part_names[p]
        out.append((f"part{p}", PART_EMOJI[i % len(PART_EMOJI)], f"{name} Conquered",
                    f"Clear {name} (chapters {nums[0]}–{nums[-1]})", lambda k, p=p: k.part_done[p], ALWAYS))
    return out
SOURCE_NAMES = {"read": "📖 Reading", "ex": "⚔️ Exercises", "boss": "🐉 Bosses", "clear": "🏁 Chapter clears",
                "part": "🏰 Part clears", "book": "🏆 Book", "session": "⏱️ Focus sessions", "review": "♻️ Flashcards",
                "scribe": "📜 Notes bonuses", "streak": "🔥 Streak bonuses", "goal": "🎯 Daily goals", "badge": "🏅 Badges",
                "side": "🗺️ Side quests"}
ACTIONS = {"read", "ex", "boss", "session", "review"}


# ───────────────────────────── the rules engine ─────────────────────────────
def compute(book, save):
    k = SimpleNamespace()
    events = sorted(save["events"], key=lambda e: e["at"])
    k.read, k.exd, k.boss, k.scribe = {}, {}, {}, {}
    k.sessions, k.hours = [], []
    ledger = []                      # (at, xp, kind, label)
    action_xp = defaultdict(int)     # per day, used for the daily goal + sparkline
    review_xp = defaultdict(int)
    active = set()
    k.cards_ok = 0

    for e in events:
        t, at = e["t"], e["at"]
        d = at[:10]
        kind = t
        is_action = t in ACTIONS
        if t == "read":
            if e["id"] not in book.reading or e["id"] in k.read:
                continue
            _, q = book.reading[e["id"]]
            k.read[e["id"]] = at
            xp, label = q["xp"], f"📖 {q['id']} {q['title']}"
            if is_side_id(e["id"]):
                kind, label = "side", f"🗺️ {q['id']} {q['title']}"
        elif t == "ex":
            if e["id"] not in book.ex or e["id"] in k.exd:
                continue
            _, x = book.ex[e["id"]]
            k.exd[e["id"]] = e
            bonus = XP_CLEAN if (e.get("clean") and x["kind"] == "code") else 0
            xp, label = Book.ex_xp(x) + bonus, f"⚔️ {x['id']} {x['title']}" + (" ✨" if bonus else "")
            if x["kind"] == "lab":
                kind, label = "side", f"🧪 {x['id']} {x['title']}"
        elif t == "boss":
            b = book.bosses.get(e["n"])
            if not b or e["n"] in k.boss:
                continue
            k.boss[e["n"]] = at
            xp, label = b["xp"], f"🐉 Boss {b['n']} · {b['name']} defeated"
        elif t == "session":
            k.sessions.append(e)
            xp = min(SESSION_CAP_XP, e["min"]) if e["min"] >= SESSION_MIN else 0
            label = f"⏱️ {e['min']} min focus session"
            is_action = e["min"] >= SESSION_MIN
        elif t == "review":
            k.cards_ok += e["ok"]
            xp = max(0, min(REVIEW_CAP - review_xp[d], REVIEW_XP * e["ok"]))
            review_xp[d] += xp
            label = f"♻️ Reviewed {e['n']} flashcards ({e['ok']} ✓)"
            is_action = e["n"] > 0
        elif t == "scribe":
            if e["ch"] in k.scribe:
                continue
            k.scribe[e["ch"]] = at
            xp, label = XP_SCRIBE, f"📜 Notes bonus · {unit_name(book, e['ch'])}"
        else:
            continue
        ledger.append((at, xp, kind, label))
        if is_action:
            active.add(d)
            action_xp[d] += xp
            k.hours.append(int(at[11:13]))

    # chapters
    k.chap = {}
    done_req = total_req = 0
    for c in book.chapters:
        n = c["num"]
        req_e = Book.required_ex(c)
        dr = [q for q in c["reading"] if q["id"] in k.read]
        de = [x for x in req_e if x["id"] in k.exd]
        times = [k.read[q["id"]] for q in dr] + [k.exd[x["id"]]["at"] for x in de]
        any_times = times + [k.exd[x["id"]]["at"] for x in c["exercises"] if x["optional"] and x["id"] in k.exd]
        cleared = len(dr) == len(c["reading"]) and len(de) == len(req_e)
        v = SimpleNamespace(
            reading=(len(dr), len(c["reading"])), ex=(len(de), len(req_e)),
            opt=(sum(1 for x in c["exercises"] if x["optional"] and x["id"] in k.exd),
                 sum(1 for x in c["exercises"] if x["optional"])),
            cleared=cleared, cleared_at=max(times) if cleared and times else None,
            first_at=min(any_times) if any_times else None, started=bool(any_times),
        )
        k.chap[n] = v
        if cleared and v.cleared_at:
            ledger.append((v.cleared_at, XP_CHAPTER, "clear", f"🏁 Chapter {n} cleared · {c['title']}"))
        if not c["optional"]:
            done_req += len(dr) + len(de)
            total_req += len(c["reading"]) + len(req_e)
    k.frac = done_req / total_req if total_req else 0
    k.done_req, k.total_req = done_req, total_req

    k.part_done = {}
    for p, nums in book.parts.items():
        ok = all(k.chap[n].cleared for n in nums)
        k.part_done[p] = ok
        if ok:
            ledger.append((max(k.chap[n].cleared_at for n in nums), book.part_xp.get(p, XP_PART), "part",
                           f"🏰 {book.part_names[p]} complete"))
    k.n_bosses = len(book.bosses)
    k.book_done = all(k.chap[n].cleared for n in book.required) and len(k.boss) == k.n_bosses
    if k.book_done:
        ledger.append((max([k.chap[n].cleared_at for n in book.required] + list(k.boss.values())), XP_BOOK, "book",
                       "🏆 BOOK COMPLETE"))
    k.completionist = k.book_done and all(k.chap[c["num"]].cleared for c in book.chapters) and all(
        x["id"] in k.exd for c in book.chapters for x in c["exercises"])

    k.side = {}
    for s in book.side.values():
        allq = [q for sc in s["chapters"] for q in sc["reading"]]
        req = [q for q in allq if not q["optional"]]
        dr = [q for q in req if q["id"] in k.read]
        dl = [x for x in s["labs"] if x["id"] in k.exd]
        times = [k.read[q["id"]] for q in dr] + [k.exd[x["id"]]["at"] for x in dl]
        opt_read = sum(1 for q in allq if q["optional"] and q["id"] in k.read)
        fin = len(dr) == len(req) and len(dl) == len(s["labs"])
        v = SimpleNamespace(reading=(len(dr), len(req)), labs=(len(dl), len(s["labs"])),
                            opt=(opt_read, len(allq) - len(req)), finished=fin,
                            finished_at=max(times) if fin and times else None, started=bool(times) or opt_read > 0,
                            last=max(times + [k.read[q["id"]] for q in allq if q["id"] in k.read], default=""))
        k.side[s["key"]] = v
        if fin and v.finished_at:
            ledger.append((v.finished_at, s["xp"], "side", f"📗 Side quest complete · {s['short']}"))
    k.side_any = any(v.started for v in k.side.values())

    # streaks (with freezes: every 7 streak days banks one, max 2; a freeze covers one missed day)
    days = sorted(date.fromisoformat(d) for d in active)
    streak = freezes = best = max_gap = 0
    prev = None
    for d in days:
        if prev is None:
            streak = 1
        else:
            gap = (d - prev).days - 1
            max_gap = max(max_gap, gap)
            if gap == 0:
                streak += 1
            elif gap <= freezes:
                freezes -= gap
                streak += 1
            else:
                streak = 1
        if streak % 7 == 0:
            freezes = min(MAX_FREEZES, freezes + 1)
        best = max(best, streak)
        bonus = STREAK_BONUS * min(streak, STREAK_BONUS_CAP)
        ledger.append((f"{d.isoformat()}T23:59:59", bonus, "streak", f"🔥 Day-{streak} streak bonus"))
        prev = d
    today = now().date()
    k.today_active = prev == today
    if prev is None:
        k.streak = 0
    elif prev == today or (today - prev).days - 1 <= freezes:
        k.streak = streak
    else:
        k.streak = 0
    k.best, k.freezes, k.max_gap = best, freezes, max_gap
    k.at_risk = k.streak > 0 and not k.today_active
    k.freeze_needed = 0 if prev is None else max(0, (today - prev).days - 1)

    # daily goal
    k.goal = save["settings"]["daily_goal"]
    for d, x in action_xp.items():
        if x >= k.goal:
            ledger.append((f"{d}T23:59:58", XP_DAILY_GOAL, "goal", "🎯 Daily goal reached"))
    k.today_xp = action_xp.get(today.isoformat(), 0)
    k.last14 = [action_xp.get((today - timedelta(days=i)).isoformat(), 0) for i in range(13, -1, -1)]
    k.action_xp = dict(action_xp)

    # misc stats for badges
    k.clean = sum(1 for e in k.exd.values() if e.get("clean") and book.ex[e["id"]][1]["kind"] == "code")
    k.hard = sum(1 for i in k.exd if book.ex[i][1]["stars"] == 3)
    k.minutes = sum(s["min"] for s in k.sessions)
    k.longest = max((s["min"] for s in k.sessions), default=0)
    k.speedrun = any(
        v.cleared and v.first_at and n in book.required[1:] and
        datetime.fromisoformat(v.cleared_at) - datetime.fromisoformat(v.first_at) <= timedelta(days=3)
        for n, v in k.chap.items())

    k.badges = [b[0] for b in book.badges if b[4](k)]
    for bid in k.badges:
        b = book.badge_by_id[bid]
        ledger.append((save["badge_dates"].get(bid, iso(now())), XP_BADGE, "badge", f"{b[1]} Badge: {b[2]}"))

    ledger.sort(key=lambda r: r[0])
    k.ledger = ledger
    k.xp = sum(r[1] for r in ledger)
    k.level = level_for(k.xp)
    k.lo, k.hi = threshold(k.level), threshold(k.level + 1)
    k.current = next((n for n in book.required if not k.chap[n].cleared), None)
    return k


