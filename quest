           "out", "key", "own", "web", "few", "old", "law", "map", "run", "see", "way", "day", "end", "top", "art", "are",
           "our", "who", "now", "yes", "big", "bad", "fun", "war", "age", "act", "add", "god", "man", "men", "sex", "eat"}
VILLAINS = [
    ("The Forgetting Fog", "It feeds on everything you read but never revisit."),
    ("The Skimming Shade", "It whispers that you understood a page you only looked at."),
    ("The Distraction Drake", "It breathes notifications and hates focus sessions."),
    ("The Procrastination Hydra", "Cut off one \"later\" and two more grow back."),
    ("The Illusion of Competence", "Rereading feels like learning. It isn't, and this boss knows it."),
    ("The Confusion Golem", "Built from every question you didn't write down."),
    ("The Doubt Wraith", "It says you're not the kind of person who finishes books."),
