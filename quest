def boss_goals(b):
    readme = book_boss_readme(b)
    if not readme.exists():
        return []
    out, in_win = [], False
    for ln in readme.read_text(encoding="utf-8").splitlines():
        if ln.startswith("## "):
            in_win = ln[3:].strip().lower().startswith("win conditions")
            continue
        m = re.match(r"^\s*[-*]\s*\[([ xX])\]\s*(.*)$", ln)
        if in_win and m:
            out.append({"text": m.group(2), "done": m.group(1).lower() == "x"})
    return out


def boss_tick(b, index, on):
    readme = book_boss_readme(b)
    lines = readme.read_text(encoding="utf-8").splitlines(keepends=True)
    in_win, i = False, -1
    for j, ln in enumerate(lines):
        if ln.startswith("## "):
            in_win = ln[3:].strip().lower().startswith("win conditions")
            continue
        m = re.match(r"^(\s*[-*]\s*\[)([ xX])(\].*)$", ln, re.S)
        if in_win and m:
            i += 1
            if i == index:
                lines[j] = m.group(1) + ("x" if on else " ") + m.group(3)
                readme.write_text("".join(lines), encoding="utf-8")
                return True
    return False


