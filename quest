          f" · 🎯 {k.today_xp}/{k.goal} · 🔥 {k.streak}")


def split_flags(args):
    flags = {a for a in args if a in ("--asan", "--tsan", "--force")}
    rest = [a for a in args if a not in flags]
    return flags, rest


def cmd_run(book, args):
    if "--" in args:
        i = args.index("--")
        args, prog_args = args[:i], args[i + 1:]
    else:
        prog_args = []
    flags, rest = split_flags(args)
    if not rest:
        die("Usage: ./quest run <exercise-id | bossN | path/to/file> [--asan|--tsan] [-- program args]")
    if not book.code:
        die('This book has no code setup. Add "code": "cpp" (or "c", "python", "javascript") to .quest/book.json.')
    label, srcs, name = resolve_target(book, rest[0])
    if not srcs:
        die(f"No source files found for {label}. Run ./quest init to recreate stubs.")
    san = "asan" if "--asan" in flags else "tsan" if "--tsan" in flags else None
    ok, warns, run = build(srcs, name + ("-" + san if san else ""), san)
    if not ok:
        die("Build failed. Fix the first error, then try again (the first error usually causes the rest).")
    print(GRN(f"  ✔ built") + (YEL(f" with {warns} warning(s)") if warns else DIM(" · 0 warnings")))
    if not run:
        return
    print(DIM("  ── program output " + "─" * 40))
    sys.stdout.flush()
    try:
        r = subprocess.run(run + prog_args, cwd=ROOT)
        code = r.returncode
    except KeyboardInterrupt:
        code = 130
    print(DIM("  " + "─" * 58))
    print((GRN if code == 0 else YEL)(f"  exit code {code}"))


def cmd_done(book, args):
    flags, rest = split_flags(args)
    if not rest:
        die("Usage: ./quest done <id> [more ids] [\"note for your journal\"] [--asan] [--force]")
    ids = [a for a in rest if a in book.ex]
    notes = [a for a in rest if a not in book.ex]
    if not ids:
        die(f"Unknown exercise '{rest[0]}'. See ./quest ch <n> for ids.")
    if any(re.fullmatch(r"(\d+|[a-z]+)-\d+", n) for n in notes):
        die(f"Unknown exercise id among: {', '.join(notes)}")
    note = " ".join(notes).strip()
    save0 = load_save()
    k0 = compute(book, save0)
    results = []
    built = {}
    for i in ids:
        c, e = book.ex[i]
        prior = k0.exd.get(i)
        if prior and (prior.get("clean") or e["kind"] != "code"):
            print(DIM(f"  {i} is already complete ({prior['at'][:10]})."))
            continue
        clean = False
        if e["kind"] == "code" and book.code and "--force" not in flags:
            p = book.ex_path(c, e)
            if not sources_in(p):
                die(f"{rel(p)} is missing. Run ./quest init to recreate it.")
            if untouched(book, p):
                die(f"{rel(p)} is still empty. Write some code first!")
            if p not in built:
                print(f"  ⚔️  Checking {i}: {e['title']}")
                built[p] = build(sources_in(p), p.stem if p.is_file() else p.name,
                                 "asan" if "--asan" in flags else None)
            ok, warns, _ = built[p]
            if not ok:
                die("It doesn't compile yet, so no XP. Fix the errors above and run ./quest done again.")
            clean = warns == 0
            if not clean:
                print(YEL(f"  {warns} warning(s). Accepted, but fix them and re-run done for the +{XP_CLEAN} clean-build bonus."))
        elif e["kind"] == "code" and book.code:
            print(YEL("  --force: skipping the compile check (no clean-build bonus)."))
        if prior and e["kind"] == "code" and not prior.get("clean") and clean:
            results.append(("upgrade", i, e))
        elif not prior:
            results.append(("new", i, e, clean))

    def fn(save):
        for r in results:
            if r[0] == "upgrade":
                for ev in save["events"]:
                    if ev["t"] == "ex" and ev["id"] == r[1]:
                        ev["clean"] = True
                print(f"  ✨ {r[1]} now builds warning-free  {YEL('+' + str(XP_CLEAN) + ' XP')}")
            else:
                _, i, e, clean = r
                save["events"].append({"t": "ex", "id": i, "at": iso(now()), "clean": clean})
                xp = Book.ex_xp(e) + (XP_CLEAN if clean else 0)
                extra = f" (incl. +{XP_CLEAN} clean build ✨)" if clean else ""
                print(f"  {GRN('✔')} {i} {e['title']}  {YEL('+' + str(xp) + ' XP')}{DIM(extra)}")
        if note and results:
            journal_append([f"- ⚔️ {now():%H:%M} · {', '.join(r[1] for r in results)}: {note}"])

    save, k = mutate(book, fn)
    main_ids = [i for i in ids if not is_side_id(i)]
    if main_ids:
        c = book.ch[int(main_ids[-1].split("-")[0])]
        left = [e for e in Book.required_ex(c) if e["id"] not in k.exd]
        if left:
            print(DIM(f"  next in chapter {c['num']}: {left[0]['id']} {left[0]['title']}"))
    mini(k)


def boss_hp(b):
    readme = book_boss_readme(b)
    if not readme.exists():
        return 0, len(b["goals"])
    text = readme.read_text(encoding="utf-8")
    sec = re.split(r"^## ", text, flags=re.M)
    win = next((s for s in sec if s.lower().startswith("win conditions")), "")
    ticks = re.findall(r"^\s*[-*]\s*\[([ xX])\]", win, re.M)
    return sum(1 for t in ticks if t.lower() == "x"), len(ticks)


def book_boss_readme(b):
    return PROJECTS / b["dir"] / "README.md"


def cmd_boss(book, args):
    save = load_save()
    k = compute(book, save)
    if not args:
        print()
        for b in book.bosses.values():
            done, total = boss_hp(b)
            print(f"  {boss_icon(k, b)}  Boss {b['n']} · {B(b['name']):<28} {DIM(boss_state(k, b))}  "
                  f"{YEL(str(b['xp']) + ' XP')}  {DIM('win conditions ' + str(done) + '/' + str(total))}")
        print(DIM("\n  ./quest boss <n> to fight · specs in projects/<boss>/README.md\n"))
        return
    try:
        b = book.bosses[int(args[0].lstrip("bB").replace("oss", ""))]
    except (ValueError, KeyError):
        die(f"Usage: ./quest boss <1-{len(book.bosses)}>" if book.bosses else "This book has no bosses.")
    d = book.boss_dir(b)
    print(f"\n  🐉 {B(RED('Boss ' + str(b['n']) + ' · ' + b['name']))}   reward {YEL(str(b['xp']) + ' XP')}")
    print(wrap(b["pitch"], "     "))
    if b["n"] in k.boss:
        print(GRN(f"\n  💀 Already defeated on {k.boss[b['n']][:10]}. Glory is eternal.\n"))
        return
    if not boss_unlocked(k, b):
        need = [n for n in b["unlock"] if not k.chap[n].cleared]
        print(YEL(f"\n  🔒 Locked. Clear chapter{'s' if len(need) > 1 else ''} {', '.join(map(str, need))} first.\n"))
        return
    done, total = boss_hp(b)
    hp = total - done
    print(f"\n  Boss HP  {RED(bar(hp / total if total else 1, 24))}  {hp}/{total}   (tick win conditions in {rel(book_boss_readme(b))})")
    if not boss_codes(book, b):
        if done < total or total == 0:
            print(YEL(f"\n  The boss still has {hp} HP."))
            print(DIM(f"  Tick each win condition in {rel(book_boss_readme(b))} as you finish it, then attack again."))
            return
        return boss_defeated(book, b)
    srcs = sources_in(d)
    if not srcs:
        die(f"No source files in {rel(d)}.")
    if untouched(book, srcs[0]) and len(srcs) == 1:
        die(f"{srcs[0].name} is still empty. Read the README, plan, and start coding!")
    if b["build"] == "boost" and not boost_available():
        die(f"This boss needs Boost: {boost_hint()}")
    san = {"sanitize": "asan", "tsan": "tsan"}.get(b["build"])
    print(f"\n  ⚔️  Attack 1: build{(' with ' + san.upper()) if san else ''}")
    ok, warns, run = build(srcs, b["dir"] + ("-" + san if san else ""), san)
    if not ok:
        die("The boss shrugs off your attack: the build failed.")
    print(GRN("  ✔ hit!") + (YEL(f" ({warns} warnings)") if warns else ""))
    passed = True
    if b.get("tests") and run:
        tests = sorted((d / "tests").glob("*.in"))
        print(f"\n  ⚔️  Attack 2: {len(tests)} test script(s)")
        for t in tests:
            exp = t.with_suffix(".out")
            if not exp.exists():
                print(YEL(f"    ? {t.name}: no {exp.name}, skipped"))
                continue
            try:
                r = subprocess.run(run, stdin=t.open(), capture_output=True, text=True, timeout=30, cwd=ROOT)
            except subprocess.TimeoutExpired:
                print(RED(f"    ✗ {t.name}: timed out (does QUIT exit?)"))
                passed = False
                continue
            norm = lambda s: "\n".join(ln.rstrip() for ln in s.strip().splitlines())
            if norm(r.stdout) == norm(exp.read_text()):
                print(GRN(f"    ✔ {t.name}"))
            else:
                passed = False
                print(RED(f"    ✗ {t.name}"))
                diff = difflib.unified_diff(norm(exp.read_text()).splitlines(), norm(r.stdout).splitlines(),
                                            "expected", "yours", lineterm="")
                for ln in list(diff)[:20]:
                    print("      " + ln)
        if len(tests) < b.get("min_tests", 0):
            print(YEL(f"    Only {len(tests)} test pair(s); the spec asks for at least {b['min_tests']}."))
    elif boss_selftest(b) and run:
        print(f"\n  ⚔️  Attack 2: self-test  {' '.join(run + b.get('args', []))}")
        sys.stdout.flush()
        try:
            code = subprocess.run(run + b.get("args", []), timeout=120, cwd=ROOT).returncode
        except subprocess.TimeoutExpired:
            code = "timeout (120 s)"
        passed = code == 0
        print(GRN("  ✔ hit!") if passed else RED(f"  ✗ missed: exit code {code}"))
    if not passed:
        die("The boss is still standing. Fix the failures above and attack again.")
    if done < total or total == 0:
        print(YEL(f"\n  The build holds, but the boss still has {hp} HP."))
        print(DIM(f"  Tick each win condition in {rel(book_boss_readme(b))} as you finish it, then attack again."))
        return
    boss_defeated(book, b)


def boss_defeated(book, b):
    def fn(s):
        s["events"].append({"t": "boss", "n": b["n"], "at": iso(now())})
        journal_append([f"- 🐉 {now():%H:%M} · **Defeated Boss {b['n']}: {b['name']}**"])

