_BOOK = None


class Book:
    def __init__(self):
        global _BOOK
        if not BOOK_FILE.exists():
            die("No book yet. Put a PDF in this folder and run: ./quest add <file>.pdf")
        d = json.loads(BOOK_FILE.read_text(encoding="utf-8"))
        self.data = d
        self.title = d["title"]
        self.short = d.get("short") or d["title"].split(":")[0].split(" — ")[0].strip()
        self.companion = d.get("companion_code", "")
        self.titles = d.get("titles") or TITLES[:-1] + [f"{self.short} Conqueror"]
        self.code = CODE_PRESETS.get(d.get("code")) if isinstance(d.get("code"), str) else d.get("code")
        self.chapters = d["chapters"]
        for c in self.chapters:
            c.setdefault("exercises", [])
            c.setdefault("part", 1)
            c.setdefault("optional", False)
        self.ch = {c["num"]: c for c in self.chapters}
        self.required = [c["num"] for c in self.chapters if not c["optional"]]
        self.bosses = {b["n"]: b for b in d.get("bosses", [])}
        names = {int(k): v for k, v in (d.get("parts") or {}).items()}
        found = sorted({c["part"] for c in self.chapters if not c["optional"]})
        self.parts = {p: [c["num"] for c in self.chapters if c["part"] == p and not c["optional"]]
                      for p in found} if len(found) > 1 else {}
        self.part_names = {p: names.get(p, f"Part {roman(p)}") for p in found}
        self.part_xp = {int(k): v for k, v in (d.get("part_xp") or {}).items()}
        self.reading, self.ex = {}, {}
        for c in self.chapters:
            for q in c["reading"]:
                self.reading[q["id"]] = (c, q)
            for e in c["exercises"]:
                self.ex[e["id"]] = (c, e)
        self.side = {s["key"]: s for s in d.get("side", [])}
        for s in self.side.values():
            s.setdefault("labs", [])
            for k_, v in (("pairs", []), ("pairs_text", ""), ("note", ""), ("author", ""), ("xp", 300)):
                s.setdefault(k_, v)
            for sc in s["chapters"]:
                for q in sc["reading"]:
                    q.setdefault("optional", bool(sc.get("optional")))
                    self.reading[q["id"]] = (s, q)
            for lab in s["labs"]:
                self.ex[lab["id"]] = (s, lab)
        self.has_code = any(e["kind"] == "code" for _, e in self.ex.values())
        self.badges = [b for b in BADGES + part_badges(self) if b[5](self)]
        self.badge_by_id = {b[0]: b for b in self.badges}
        _BOOK = self

    def ex_path(self, c, e):
        return ROOT / c["dir"] / "exercises" / e["file"].rstrip("/")

    @staticmethod
    def is_dir(e):
        return e["file"].endswith("/")

    @staticmethod
    def ex_xp(e):
        return XP_STARS[e["stars"]] if e["kind"] in ("code", "lab") else XP_NONCODE

    @staticmethod
    def required_ex(c):
        return [e for e in c["exercises"] if not e["optional"]]

    def boss_dir(self, b):
        return PROJECTS / b["dir"]

    def pdf(self):
        return find_pdf(self.data.get("pdf"), self.data.get("pdf_match"), top_only=True)

    def side_pdf(self, s):
        return find_pdf(s.get("pdf"), s.get("pdf_match"))


def find_pdf(path, match=None, top_only=False):
    """The book's PDF: its recorded path if it's still there, else a file whose name contains `match`."""
    if path and (ROOT / path).is_file():
        return ROOT / path
    pdfs = sorted(ROOT.glob("*.pdf") if top_only else ROOT.rglob("*.pdf"))
    if match:
        pdfs = [p for p in pdfs if match.lower() in p.name.lower()]
    elif path:
        pdfs = [p for p in pdfs if p.name == Path(path).name]
    return pdfs[0] if pdfs else None


def pages_of(q):
    return f"p.{q['page']}–{q.get('page_end', q['end'])}"


def is_side_id(i):
    return not i.split(".")[0].split("-")[0].isdigit()


def load_save():
    s = json.loads(SAVE_FILE.read_text(encoding="utf-8")) if SAVE_FILE.exists() else {}
    s.setdefault("version", 1)
    s.setdefault("created", iso(now()))
    s.setdefault("settings", {}).setdefault("daily_goal", DEFAULT_GOAL)
    s.setdefault("events", [])
    s.setdefault("session", None)
    s.setdefault("cards", {})
    s.setdefault("badge_dates", {})
    return s


def write_save(s):
    QDIR.mkdir(exist_ok=True)
    tmp = SAVE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(SAVE_FILE)


