def bench_markdown(R_):
    e, s, m = R_["engine"], R_["server"], R_["machine"]
    L = [f"# Book Quest · benchmark results", "",
         f"{m['cpu']} ({m['cores']} cores: {m['performance_cores']} performance + {m['efficiency_cores']} efficiency) · "
         f"{m['memory_gb']} GB · macOS {m['macos']} · Python {m['python']} · {m['date'][:10]}", "",
         f"Book: *{R_['book']['title']}*, {R_['book']['pages']} pages. Pages are drawn for an iPad-sized box of "
         f"{e['box'][0]}×{e['box'][1]} px ({e['page_px'][0]}×{e['page_px'][1]} px per page). Engine timings are the best of "
         f"{e['rounds']} round(s) per page; percentiles are across {e['text_pages']} text pages.", ""]
    jc = e["codecs"]["jpeg_color"]["bytes"]["p50"]
    L += ["## Codecs: one page, five ways", "", "| Encoder | Size p50 | Size p95 | vs JPEG | Encode p50 | Encode p95 |",
          "|---|---:|---:|---:|---:|---:|"]
    names = {"png4_neon_n": "**16-shade PNG (ours: NEON + 8-core deflate)**", "jpeg_color": "JPEG q0.8, color (ImageIO)",
             "jpeg_gray": "JPEG q0.8, gray (ImageIO)", "heic": "HEIC q0.6 (ImageIO)", "png_gray8": "PNG 8-bit gray (ImageIO)",
             "preview": "Preview: ¼-size JPEG q0.5"}
    for k_, label in names.items():
        c_ = e["codecs"][k_]
        L.append(f"| {label} | {_f(c_['bytes']['p50'], 'KB')} | {_f(c_['bytes']['p95'], 'KB')} | "
                 f"{c_['bytes']['p50'] / jc:.2f}× | {_f(c_['ms']['p50'])} | {_f(c_['ms']['p95'])} |")
    st_ = e["stages"]
    L += ["", f"Every PNG was decoded again with ImageIO and compared with the reference quantizer: "
              f"**{e['mismatched_pixels']} mismatched pixels** out of {e['verified_pixels']:,} checked.", "",
          "## Inside the encoder", "", "| Stage | p50 | p95 |", "|---|---:|---:|"]
    for k_, label in [("draw_ms", "PDFKit draw, grayscale"), ("color_check_ms", "Separate color check (old: a second draw)"),
                      ("draw_rgb_ms", "PDFKit draw, color (new: once)"), ("gray_color_pass_ms", "NEON pass: gray + color detection"),
                      ("png4_scalar_1_pack_ms", "Quantize + pack, scalar C"), ("png4_neon_1_pack_ms", "Quantize + pack, NEON, 1 core"),
                      ("png4_neon_n_pack_ms", "Quantize + pack, NEON, 8 cores"), ("png4_neon_1_deflate_ms", "Deflate, 1 core"),
                      ("png4_neon_n_deflate_ms", "Deflate, 8 strips in parallel"), ("png4_scalar_1_ms", "PNG encode, scalar, 1 core"),
                      ("png4_neon_n_ms", "**PNG encode, NEON, 8 cores**"), ("first_render_ms", "**Whole page, first time (draw → PNG)**"),
                      ("repeat_render_ms", "Whole page, colors already known")]:
        L.append(f"| {label} | {_f(st_[k_]['p50'])} | {_f(st_[k_]['p95'])} |")
    L += ["", "| Compression strips | 1 | 2 | 4 | 8 |", "|---|---:|---:|---:|---:|",
          "| PNG encode p50 | " + " | ".join(_f(e["scaling"][c]["p50"]) for c in (1, 2, 4, 8)) + " |", ""]
    L += ["## Server, end to end (HTTP over loopback)", "", "| Path | p50 | p95 | p99 |", "|---|---:|---:|---:|"]
    for k_, label in [("memory_hit", "Page from memory"), ("disk_hit_after_restart", "Page from disk, right after a restart"),
                      ("cold_page", "Page never drawn before"), ("cold_preview", "Preview never drawn before")]:
        x = s[k_]
        L.append(f"| {label} | {_f(x['p50'])} | {_f(x['p95'])} | {_f(x['p99'])} |")
    p_ = s["push"]
    for k_, label in [("warm_receive", "Push → reader receives it (page drawn ahead)"), ("warm_ack", "Push → Mac gets the acknowledgement"),
                      ("warm_sharp_page", "Push → sharp page delivered (drawn ahead)"), ("cold_receive", "Push → reader receives it (cold)"),
                      ("cold_sharp_page", "Push → sharp page delivered (cold)")]:
        if k_ in p_:
            L.append(f"| {label} | {_f(p_[k_]['p50'])} | {_f(p_[k_]['p95'])} | {_f(p_[k_]['p99'])} |")
    L.append(f"| Quest state (gzip {s['state']['bytes_plain'] // 1024} KB → {s['state']['bytes_gzip'] // 1024} KB) | "
             f"{_f(s['state']['ms']['p50'])} | {_f(s['state']['ms']['p95'])} | {_f(s['state']['ms']['p99'])} |")
    t_, wb = s["throughput"], s["whole_book"]
    L += ["", f"- **Throughput:** {t_['requests_per_s']:,.0f} page requests/s ({t_['mb_per_s']:,.0f} MB/s) with {t_['clients']} clients.",
          f"- **Whole book in the background:** {wb['filled']}/{wb['pages']} pages in {wb['seconds']:.1f} s "
          f"({wb['pages_per_s']:.1f} pages/s on one core), {wb['disk_mb']:.0f} MB on disk.",
          f"- **Page sizes over the wire:** {_f(s['page_bytes']['p50'], 'KB')} p50, {_f(s['page_bytes']['p95'], 'KB')} p95 "
          f"({', '.join(f'{v} {k_}' for k_, v in s['page_types'].items())})."]
    if "memory_mb" in s:
        mm = s["memory_mb"]
        L.append(f"- **Memory:** server {mm['server']:.0f} MB with the whole book cached; {mm['helper_count']} helpers {mm['helpers']:.0f} MB.")
    if R_["device"]:
        L += ["", "## On real devices (reported by the reader)", "", "| Device | Measurement | n | p50 | p95 | p99 |",
              "|---|---|---:|---:|---:|---:|"]
        order = list(DEVICE_KINDS)
        for dev, kinds in sorted(R_["device"].items()):
            for kind, x in sorted(kinds.items(), key=lambda kv: order.index(kv[0]) if kv[0] in order else 99):
                L.append(f"| {dev} | {DEVICE_KINDS.get(kind, kind)} | {x['n']} | {_f(x['p50'])} | {_f(x['p95'])} | {_f(x['p99'])} |")
    else:
        L += ["", "_No device timings yet: open the reader on an iPad with `./quest world --ipad`, read a while, then run this again._"]
    L.append("")
    return "\n".join(L)


