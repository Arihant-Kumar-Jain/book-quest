STUB_HASHES = QDIR / "stubs.json"


def sha(data):
    return hashlib.sha1(data).hexdigest()


def load_stub_hashes():
    return json.loads(STUB_HASHES.read_text()) if STUB_HASHES.exists() else {}


def untouched(book, path):
    """True if the file/folder still holds exactly what `quest init` generated (by recorded hash or template)."""
    rec, st = load_stub_hashes(), stubs(book)

    def same(f):
        data = f.read_bytes()
        if not data.strip():
            return True
        return rec.get(rel(f)) == sha(data) or st.get(f, "").encode("utf-8") == data

    if path.is_dir():
        files = [f for f in path.rglob("*") if f.is_file() and f.name != ".DS_Store"]
        return all(same(f) for f in files)
    return path.exists() and same(path)


def unit_name(book, ch):
    if isinstance(ch, int):
