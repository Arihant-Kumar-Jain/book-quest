    for c in book.chapters:
        v = k.chap[c["num"]]
        icon = "✅" if v.cleared else ("▶️" if c["num"] == k.current or v.started else "⬜")
        status = f"Cleared {v.cleared_at[:10]}" if v.cleared else ("In progress" if v.started else ("Optional" if c["optional"] else ""))
        ex = f"{v.ex[0]}/{v.ex[1]}" + (f" (+{v.opt[0]}/{v.opt[1]} opt)" if v.opt[1] else "") if v.ex[1] or v.opt[1] else "—"
        lines.append(f"| {icon} | {c['num']} | {c['title']} | {v.reading[0]}/{v.reading[1]} | {ex} | {status} |")
        b = boss_after.get(c["num"])
        if b:
            lines.append(f"| {boss_icon(k, b)} | B{b['n']} | **Boss: {b['name']}** | | | {boss_state(k, b)} |")
    if book.side:
        lines += ["", "## 🗺️ Side quests (optional)", "", "| | Book | Reading | Labs | Status |", "|---|---|---|---|---|"]
        for s in book.side.values():
            v = k.side[s["key"]]
            icon = "📗" if v.finished else ("▶️" if v.started else "⬜")
            st = f"Finished {v.finished_at[:10]}" if v.finished else ("In progress" if v.started else f"+{s['xp']} XP when finished")
            opt = f" (+{v.opt[0]}/{v.opt[1]} opt)" if v.opt[1] else ""
            lines.append(f"| {icon} | [{s['short']}]({s['dir']}/notes.md) | {v.reading[0]}/{v.reading[1]}{opt} | {v.labs[0]}/{v.labs[1]} | {st} |")
    lines += ["", "## 🏅 Badges", ""]
    for bid, emo, name, desc, *_ in book.badges:
        if bid in k.badges:
            lines.append(f"- {emo} **{name}** · {desc} · _{save['badge_dates'].get(bid, '')[:10]}_")
    locked = [b for b in book.badges if b[0] not in k.badges]
    if locked:
        lines += ["", "<details><summary>Locked badges</summary>", ""]
        lines += [f"- 🔒 {name} · {desc}" for _, _, name, desc, *_ in locked]
        lines += ["", "</details>"]
    lines += ["", "## 📅 Last 12 weeks", "", "```"] + heatmap(k) + ["```",
              f"`·` nothing · `░` < half goal · `▒` < goal · `▓` goal hit · `█` 2× goal (goal = {k.goal} XP)", ""]
    by = defaultdict(int)
    for _, xp, kind, _ in k.ledger:
        by[kind] += xp
    names = SOURCE_NAMES
    lines += ["## 📈 Where your XP came from", "", "| Source | XP |", "|---|---|"]
    lines += [f"| {names[kd]} | {fmt(v)} |" for kd, v in sorted(by.items(), key=lambda r: -r[1]) if v]
    recent = [r for r in k.ledger if r[2] not in ("streak", "goal")][-12:]
    lines += ["", "## 📜 Recent activity", ""]
    lines += [f"- `{at[:16].replace('T', ' ')}` {label} (+{xp})" for at, xp, _, label in reversed(recent)] or ["- Nothing yet. Run `./quest start`."]
    lines.append("")
    text = "\n".join(lines)
    if not PROGRESS.exists() or PROGRESS.read_text(encoding="utf-8") != text:
        PROGRESS.write_text(text, encoding="utf-8")


def boss_unlocked(k, b):
