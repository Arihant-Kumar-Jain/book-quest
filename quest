             f"| **Lv {k.level} · {title_for(k.level)}** | {fmt(k.xp)} | {fmt(k.hi - k.xp)} XP to Lv {k.level + 1} "
             f"| 🔥 {k.streak} day{'s' if k.streak != 1 else ''} | {k.best} | {hm(k.minutes)} | {len(k.badges)}/{len(book.badges)} |", "",
             f"**Book:** `{bar(k.frac, 30)}` {pct}% of required quests ({k.done_req}/{k.total_req})", ""]
