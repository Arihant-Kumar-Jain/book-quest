                    "date": save["badge_dates"].get(bid)} for bid, emo, name, desc, *_ in book.badges],
        "next": nxt, "recent": list(reversed(recent)), "cards": len(load_cards(book)),
        "book": {"title": book.title, "short": book.short, "code": bool(book.code),
