    class Server(http.server.ThreadingHTTPServer):
        def handle_error(self, request, client_address):
            # Browsers drop idle or half-finished connections all the time (a reload, Safari tidying up
            # its keep-alive sockets, an iPad going to sleep). That's normal: don't print a traceback.
            e = sys.exc_info()[1]
            if isinstance(e, (ConnectionError, TimeoutError)) or (isinstance(e, OSError) and e.errno in (22, 57)):
                return                               # 22/57: the socket was already gone (EINVAL, ENOTCONN)
            super().handle_error(request, client_address)

