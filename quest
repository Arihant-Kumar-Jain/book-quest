def scaffold(book):
    files = {}
    ext = book.code["ext"][0] if book.code else ".txt"
    for c in book.chapters:
        base = ROOT / c["dir"]
        files[base / "notes.md"] = notes_template(c)
        if book.code and book.code.get("listings"):
            files[base / "listings" / ".gitkeep"] = ""
        groups = {}
        for e in c["exercises"]:
            if e.get("file"):
                groups.setdefault(e["file"], []).append(e)
        for f, exs in groups.items():
            p = base / "exercises" / f.rstrip("/")
            if f.endswith("/"):
                files[p / ("main" + ext)] = stub_template(c, exs, True)
            else:
                files[p] = stub_template(c, exs, False)
    if book.bosses:
        files[PROJECTS / "README.md"] = projects_index(book)
    for b in book.bosses.values():
        d = PROJECTS / b["dir"]
        files[d / "README.md"] = boss_readme(book, b)
        if boss_codes(book, b):
            files[d / ("main" + ext)] = boss_stub(b)
        for name, content in (b.get("files") or {}).items():
            files[d / name] = content
    for s in book.side.values():
        d = ROOT / s["dir"]
        files[d / "notes.md"] = side_notes_template(s)
        if s.get("lab_dir"):
            files[d / "lab" / ".gitkeep"] = ""
    if book.side:
        files[ROOT / "side_quests" / "README.md"] = side_index(book)
    files[JOURNAL] = journal_template()
    files[ROOT / "cheatsheet.md"] = CHEATSHEET_TEMPLATE
    files[ROOT / ".gitignore"] = GITIGNORE
    return files


