        v = k.side[s["key"]]
        side.append({"key": s["key"], "short": s["short"], "title": s["title"], "author": s["author"], "xp": s["xp"],
                     "pairs": s["pairs"], "pairs_text": s["pairs_text"], "note": s["note"], "notes": f"{s['dir']}/notes.md",
