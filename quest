def mutate(book, fn, quiet=False):
    save = load_save()
    before = compute(book, save)
    fn(save)
    add_scribe_events(book, save)
    after = compute(book, save)
    celebrate(book, save, before, after, quiet)
    after = compute(book, save)  # badge dates may have changed
    write_save(save)
    render_progress(book, save, after)
    return save, after


