    }


_ID_READ = re.compile(r"^(\d+\.\d+|\d+|\d+\.all|[a-z]+(\.\d+)?(\.(\d+|all))?)$")
_ID_EX = re.compile(r"^(\d+|[a-z]+)-\d+$")


def _safe_text(args):
    return all(len(a) <= 600 and not a.startswith("-") for a in args)


def world_cmd_ok(args):
    if not isinstance(args, list) or not args or not all(isinstance(a, str) for a in args):
        return False
    c, rest = args[0], args[1:]
    if c == "read":
        return bool(rest) and all(_ID_READ.match(a) for a in rest)
    if c == "done":
        return len(rest) >= 1 and bool(_ID_EX.match(rest[0])) and _safe_text(rest[1:])
    if c == "run":
        return len(rest) == 1 and (bool(_ID_EX.match(rest[0])) or bool(re.fullmatch(r"boss\d", rest[0])))
    if c == "undo":
        return len(rest) <= 1 and all(re.fullmatch(r"[\w.\-]+", a) for a in rest)
    if c == "start":
        return not rest
    if c in ("stop", "log"):
        return _safe_text(rest) and (c == "stop" or bool(rest))
    if c == "boss":
        return len(rest) == 1 and rest[0].isdigit()
    return False


def open_in_editor(path):
    custom = os.environ.get("QUEST_EDITOR")
    if custom:
        cmd = shlex.split(custom) + [str(path)]
    elif shutil.which("code"):
        cmd = ["code", str(path)]
    elif shutil.which("subl"):
        cmd = ["subl", str(path)]
    elif sys.platform == "darwin":
        cmd = ["open", "-t", str(path)]
    else:
        cmd = ["xdg-open", str(path)]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


READER_HTML = QDIR / "reader.html"
LOCAL_IPS = {"127.0.0.1", "::1", "::ffff:127.0.0.1"}


PAIR_FILE = QDIR / "pair.key"


def pair_key():
    """The iPad pairing secret, kept across restarts so you only scan the QR code once."""
    import secrets
    if PAIR_FILE.exists():
        k = PAIR_FILE.read_text().strip()
        if len(k) >= 12:
            return k
    k = secrets.token_urlsafe(12)
    PAIR_FILE.write_text(k + "\n")
    os.chmod(PAIR_FILE, 0o600)
    return k


def local_hostname():
    if sys.platform == "darwin":
        try:
            r = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=3)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip() + ".local"
        except (OSError, subprocess.SubprocessError):
            pass
    return None


def local_addresses():
    """Every IPv4 address another device could use to reach this machine, as (label, ip)."""
    out = []
    try:
        r = subprocess.run(["ifconfig"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return out
    iface = None
    for ln in r.stdout.splitlines():
        m = re.match(r"^([a-z][a-z0-9]*):", ln)
        if m:
            iface = m.group(1)
            continue
        m = re.match(r"\s+inet (\d+\.\d+\.\d+\.\d+)", ln)
        if not (m and iface) or m.group(1).startswith(("127.", "169.254.")):
            continue
        ip = m.group(1)
        if ip.startswith("172.20.10."):
            label = "Personal Hotspot (cable or Wi-Fi)"
        elif iface == "en0":
            label = "Wi-Fi"
        elif iface.startswith(("bridge", "utun", "awdl", "llw", "anpi")):
            continue
        else:
            label = f"network {iface}"
        out.append((label, ip))
    return out


def lan_ip():
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))  # picks the outgoing interface; no packet is sent
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "127.0.0.1"


RENDER_SRC = QDIR / "render.swift"
RENDER_BIN = QDIR / ".bin" / "quest-render"


class PageRenderer:
    """Turns PDF pages into images with macOS PDFKit + ImageIO, through the small Swift helper in
    .quest/render.swift (built once with swiftc). The iPad then shows plain images: no PDF.js, no
    9 MB download, no internet. Rendered pages stay in memory, and neighbours are drawn ahead of time."""

    def __init__(self, workers=3):
        import queue
        import threading
        from collections import OrderedDict
        from concurrent.futures import ThreadPoolExecutor
        self.ready, self.ok, self.why = threading.Event(), False, ""
        self.idle, self.spawned, self.workers = queue.LifoQueue(), 0, workers
        self.mu = threading.Lock()
        self.cache, self.cache_bytes, self.cache_max = OrderedDict(), 0, 192 << 20
        self.inflight, self.infos = {}, {}
        self.ahead = ThreadPoolExecutor(max_workers=workers, thread_name_prefix="prerender")
        threading.Thread(target=self._build, daemon=True).start()

    def _build(self):
        try:
            if sys.platform != "darwin" or not shutil.which("swiftc"):
                self.why = "the native renderer needs macOS with the Xcode command line tools"
                return
            if not RENDER_BIN.exists() or RENDER_BIN.stat().st_mtime < RENDER_SRC.stat().st_mtime:
                RENDER_BIN.parent.mkdir(exist_ok=True)
                tmp = RENDER_BIN.with_name(RENDER_BIN.name + ".tmp")
                r = subprocess.run(["swiftc", "-o", str(tmp), str(RENDER_SRC)], capture_output=True, text=True,
                                   timeout=300)
                if r.returncode:
                    self.why = "swiftc failed: " + r.stderr.strip()[-300:]
                    return
                os.replace(tmp, RENDER_BIN)
            self.ok = True
        except (OSError, subprocess.SubprocessError) as e:
            self.why = str(e)
        finally:
            self.ready.set()

    def available(self, wait=120):
        self.ready.wait(wait)
        return self.ok

    def _take(self):
        import queue
        try:
            return self.idle.get_nowait()
        except queue.Empty:
            pass
        with self.mu:
            if self.spawned < self.workers:
                self.spawned += 1
                try:
                    return subprocess.Popen([str(RENDER_BIN)], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                            stderr=subprocess.DEVNULL)
                except OSError:
                    self.spawned -= 1
                    raise
        return self.idle.get()

    def _call(self, line):
        for attempt in (0, 1):
            p = self._take()
            try:
                p.stdin.write(line.encode("utf-8") + b"\n")
                p.stdin.flush()
                head = p.stdout.readline().decode().rstrip("\n").split("\t")
                body = p.stdout.read(int(head[1]))
            except (OSError, ValueError, IndexError):
                p.kill()
                with self.mu:
                    self.spawned -= 1
                if attempt:
                    raise OSError("the page renderer stopped")
                continue
            self.idle.put(p)
            if head[0] != "OK":
                raise ValueError(body.decode("utf-8", "replace"))
            return body

    @staticmethod
    def version(path):
        st = path.stat()
        return f"{st.st_mtime_ns:x}{st.st_size:x}"[-12:]

    def info(self, path):
        """Page count, printed page labels and page sizes in points, cached per PDF version."""
        v = self.version(path)
        if (path, v) not in self.infos:
            if "\t" in str(path) or "\n" in str(path):
                raise ValueError("unsupported file name")
            self.infos[(path, v)] = dict(json.loads(self._call(f"I\t{path}")), v=v)
        return self.infos[(path, v)]

    def render(self, path, page, w, h):
        from concurrent.futures import Future
        key = (str(path), self.version(path), page, w, h)
        with self.mu:
            if key in self.cache:
                self.cache.move_to_end(key)
                return self.cache[key]
            fut = self.inflight.get(key)
            mine = fut is None
            if mine:
                fut = self.inflight[key] = Future()
        if not mine:
            return fut.result()
        try:
            data = self._call(f"R\t{path}\t{page}\t{w}\t{h or 8192}\tjpeg\t0.8")   # h=0: fit the width
        except Exception as e:
            with self.mu:
                self.inflight.pop(key, None)
            fut.set_exception(e)
            raise
        with self.mu:
            self.inflight.pop(key, None)
            self.cache[key] = data
            self.cache_bytes += len(data)
            while self.cache_bytes > self.cache_max and self.cache:
                self.cache_bytes -= len(self.cache.popitem(last=False)[1])
        fut.set_result(data)
        return data

    def prefetch(self, path, pages, w, h):
        """Draw pages in the background so they are already in memory when the iPad asks."""
        if self.ok:
            self.ahead.submit(self._ahead, path, pages, w, h)

    def _ahead(self, path, pages, w, h):
        try:
            n = self.info(path)["n"]
            for p in pages:
                if 1 <= p <= n:
                    self.render(path, p, w, h)
        except (OSError, ValueError):
            pass


def cmd_world(book, args):
    import http.server
    import queue
    import secrets
    import threading
    import time
    import webbrowser
    from http.cookies import SimpleCookie
    from urllib.parse import parse_qs, urlparse
    port, auto_open = WORLD_PORT, "--no-open" not in args
    lan = "--ipad" in args or "--lan" in args
    if "--port" in args:
        try:
            port = int(args[args.index("--port") + 1])
        except (IndexError, ValueError):
            die("Usage: ./quest world [--ipad] [--port N] [--no-open]")
    for f in (WORLD_HTML, READER_HTML):
        if not f.exists():
            die(f"Missing {rel(f)}.")
    token = secrets.token_hex(16)
    pair = pair_key() if lan else secrets.token_urlsafe(12)
    ip = lan_ip() if lan else "127.0.0.1"
    host_alt = local_hostname() if lan else None
    lock = threading.Lock()
    me = str(Path(__file__).resolve())
    renderer = PageRenderer()
    # Live link to open readers: each one holds a Server-Sent Events stream, "Open the book" pushes a
    # page down every stream at once, and the reader acknowledges it so the Mac knows it arrived.
    live = threading.Condition()
    nav = {"seq": 0, "acked": 0, "last": None}
    readers = {}            # stream id -> queue of messages to send
    view = {}               # last image size a reader asked for, so a sent page can be drawn ahead

    def pdf_for(key):
        if key in (None, "", "main"):
            return book.pdf()
        return book.side_pdf(book.side[key]) if key in book.side else None

    def reader_connected():
        return bool(readers)

    def warm_up():
        """Index every book once at startup, so opening or switching books on the iPad is instant."""
        if not renderer.available():
            return
        for key in ["main"] + list(book.side):
            p = pdf_for(key)
            try:
                if p and p.exists():
                    renderer.info(p)
            except (OSError, ValueError):
                pass
    threading.Thread(target=warm_up, daemon=True).start()

    def num(q, name, lo, hi, default=0):
        try:
            return max(lo, min(hi, int((q.get(name) or [default])[0])))
        except ValueError:
            return default

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"       # keep-alive: page images reuse one connection
        disable_nagle_algorithm = True       # small pushes leave immediately instead of waiting for ACKs
        timeout = 120
        cookie = None

        def log_message(self, *a):
            pass

        def is_local(self):
            return self.client_address[0] in LOCAL_IPS

        def allowed(self, q):
            if self.is_local():
                return True
            if not lan:
                return False
            c = SimpleCookie(self.headers.get("Cookie", ""))
            if "qk" in c and secrets.compare_digest(c["qk"].value, pair):
                return True
            k = (q.get("key") or [""])[0]
            if k and secrets.compare_digest(k, pair):
                self.cookie = f"qk={pair}; Path=/; HttpOnly; SameSite=Strict; Max-Age=2592000"
                return True
            return False

        def send(self, code, body, ctype="application/json", cache="no-store"):
            data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", cache)
            if self.cookie:
                self.send_header("Set-Cookie", self.cookie)
            self.end_headers()
            self.wfile.write(data)

        def send_pdf(self, p):
            """The whole PDF, or the byte range PDF.js asks for (the fallback reader loads pages on demand)."""
            size = p.stat().st_size
            start, end, code = 0, size - 1, 200
            m = re.fullmatch(r"bytes=(\d*)-(\d*)", (self.headers.get("Range") or "").strip())
            if m and (m.group(1) or m.group(2)):
                if m.group(1):
                    start, end = int(m.group(1)), min(int(m.group(2) or size - 1), size - 1)
                else:
                    start = max(0, size - int(m.group(2)))
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                code = 206
            self.send_response(code)
            self.send_header("Content-Type", "application/pdf")
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            if code == 206:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.send_header("Cache-Control", "private, max-age=86400")
            if self.cookie:
                self.send_header("Set-Cookie", self.cookie)
            self.end_headers()
            try:
                with p.open("rb") as fh:
                    fh.seek(start)
                    left = end - start + 1
                    while left > 0:
                        chunk = fh.read(min(left, 256 * 1024))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True

        def events(self, q):
            """Server-Sent Events stream to one reader: pages sent from the Mac arrive the moment you click."""
            if q.get("w"):
                view.update(w=num(q, "w", 16, 4096), h=num(q, "h", 0, 4096))
            try:
                last = int(self.headers.get("Last-Event-ID") or (q.get("last") or [""])[0])
            except ValueError:
                last = None
            box = queue.Queue()
            with live:
                readers[id(box)] = box
                seq, replay = nav["seq"], nav["last"]
            try:
                self.close_connection = True
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                if self.cookie:
                    self.send_header("Set-Cookie", self.cookie)
                self.end_headers()
                out = f"retry: 1000\nid: {seq}\nevent: hello\ndata: {json.dumps({'seq': seq})}\n\n"
                if replay and last is not None and replay["seq"] > last:
                    out += f"id: {replay['seq']}\nevent: nav\ndata: {json.dumps(replay)}\n\n"
                self.wfile.write(out.encode())
                while True:
                    try:
                        msg = box.get(timeout=10)
                    except queue.Empty:
                        self.wfile.write(b": ping\n\n")
                        continue
                    if msg is None:
                        return
                    self.wfile.write(f"id: {msg['seq']}\nevent: nav\ndata: {json.dumps(msg)}\n\n".encode())
            except OSError:
                pass
            finally:
                with live:
                    readers.pop(id(box), None)

        def page_image(self, m, q):
            key, pg = m.group(1), int(m.group(2))
            p = pdf_for(key)
            if not p or not p.exists():
                return self.send(404, {"error": "no such book here"})
            if not renderer.available(0):
                return self.send(503, {"error": "native renderer not available"})
            w, h = num(q, "w", 16, 4096, 1024), num(q, "h", 0, 4096)
            try:
                data = renderer.render(p, pg, w, h)
            except (OSError, ValueError) as e:
                return self.send(404, {"error": str(e)})
            self.send(200, data, "image/jpeg", "private, max-age=31536000, immutable")
            if (q.get("ahead") or ["1"])[0] != "0":
                renderer.prefetch(p, (pg + 1, pg + 2, pg - 1), w, h)

        def page(self, f):
            html = f.read_text(encoding="utf-8").replace("__QUEST_TOKEN__", token)
            return self.send(200, html.encode("utf-8"), "text/html; charset=utf-8")

        def do_GET(self):
            u = urlparse(self.path)
            q, path = parse_qs(u.query), u.path
            if not self.allowed(q):
                return self.send(403, "<meta name=viewport content='width=device-width'><body style='font:18px -apple-system;"
                                      "padding:40px;background:#0a0d16;color:#efe6d2'><h2>🔒 Locked</h2><p>Scan the QR code from "
                                      "the 📲 button on your Mac's world map to connect this device.</p>".encode("utf-8"),
                                 "text/html; charset=utf-8")
            if path in ("/", "/index.html"):
                return self.page(WORLD_HTML)
            if path == "/read":
                return self.page(READER_HTML)
            m = re.fullmatch(r"/page/([a-z]+)/(\d+)\.jpg", path)
            if m:
                return self.page_image(m, q)
            if path.startswith("/pdf/") and path.endswith(".pdf"):
                p = pdf_for(path[5:-4])
                if not p or not p.exists():
                    return self.send(404, {"error": "no such book here"})
                return self.send_pdf(p)
            if path == "/api/events":
                return self.events(q)
            if path == "/api/book":
                key = (q.get("key") or ["main"])[0]
                p = pdf_for(key)
                if not p or not p.exists():
                    return self.send(404, {"error": "This book's PDF isn't in the folder."})
                if not renderer.available():
                    return self.send(200, {"native": False, "why": renderer.why})
                try:
                    return self.send(200, dict(renderer.info(p), native=True, key=key))
                except (OSError, ValueError) as e:
                    return self.send(200, {"native": False, "why": str(e)})
            if path == "/api/state":
                with lock:
                    return self.send(200, world_state(book))
            if path == "/api/pair":
                if not self.is_local():
                    return self.send(403, {"error": "pairing is shown on the Mac only"})
                addrs = []
                if lan and q.get("addrs"):
                    found = local_addresses() or [("Wi-Fi", ip)]
                    found.sort(key=lambda a: (a[1] != lan_ip(), a[0]))
                    addrs = [{"label": f"{lbl} · {a}", "url": f"http://{a}:{port}/read?key={pair}"} for lbl, a in found]
                    if host_alt:
                        addrs.append({"label": f"Bonjour name · {host_alt}", "url": f"http://{host_alt}:{port}/read?key={pair}"})
                return self.send(200, {"lan": lan, "connected": reader_connected(), "addresses": addrs,
                                       "url": addrs[0]["url"] if addrs else None, "native": renderer.ok})
            return self.send(404, {"error": "not found"})

        def do_POST(self):
            u = urlparse(self.path)
            q, path = parse_qs(u.query), u.path
            if not self.allowed(q):
                return self.send(403, {"error": "this device isn't paired"})
            if self.headers.get("X-Quest-Token") != token:
                return self.send(403, {"error": "bad token: reload the page"})
            origin = self.headers.get("Origin")
            if origin and origin != "http://" + (self.headers.get("Host") or ""):
                return self.send(403, {"error": "bad origin"})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                return self.send(400, {"error": "bad json"})
            if path == "/api/cmd":
                a = body.get("args")
                if not world_cmd_ok(a):
                    return self.send(400, {"error": "command not allowed"})
                timeout = 300 if a[0] == "boss" else 120
                env = dict(os.environ, NO_COLOR="1", PYTHONDONTWRITEBYTECODE="1")
                with lock:
                    try:
                        r = subprocess.run([sys.executable, me] + a, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
                                           capture_output=True, text=True, timeout=timeout)
                        out, code = (r.stdout + r.stderr), r.returncode
                    except subprocess.TimeoutExpired as e:
                        out, code = ((e.stdout or "") if isinstance(e.stdout, str) else "") + "\n(timed out)", 124
                return self.send(200, {"code": code, "output": out})
            if path == "/api/open":
                if not self.is_local():
                    return self.send(403, {"error": "files open on the Mac only"})
                p = (ROOT / str(body.get("path", ""))).resolve()
                if ROOT not in p.parents or not p.exists():
                    return self.send(400, {"error": "path not in this folder"})
                open_in_editor(p)
                return self.send(200, {"ok": True})
            if path == "/api/pdf":
                key = body.get("key") or "main"
                p = pdf_for(key)
                if not p:
                    return self.send(404, {"error": "PDF not found"})
                try:
                    pg = max(1, int(body.get("page") or 1))
                except (TypeError, ValueError):
                    pg = 1
                missed = False
                if body.get("where") != "mac" and reader_connected():
                    t0 = time.perf_counter()
                    if view and renderer.ok:
                        renderer.prefetch(p, (pg, pg + 1), view["w"], view["h"])
                    with live:
                        nav["seq"] += 1
                        msg = nav["last"] = {"seq": nav["seq"], "key": key, "page": pg, "quest": body.get("quest")}
                        for box in readers.values():
                            box.put(msg)
                        missed = not live.wait_for(lambda: nav["acked"] >= msg["seq"], timeout=1.5)
                    if not missed:
                        return self.send(200, {"where": "ipad", "ms": round((time.perf_counter() - t0) * 1000)})
                if not self.is_local() or not opener():
                    return self.send(400, {"error": "no PDF viewer here"})
                subprocess.Popen([opener(), str(p)])
                return self.send(200, {"where": "mac", "missed": missed})
            if path == "/api/ack":
                try:
                    seq = int(body.get("seq"))
                except (TypeError, ValueError):
                    return self.send(400, {"error": "bad seq"})
                with live:
                    nav["acked"] = max(nav["acked"], seq)
                    live.notify_all()
                return self.send(200, {"ok": True})
            if path == "/api/tick":
                b = book.bosses.get(body.get("n"))
                if not b or not isinstance(body.get("i"), int):
                    return self.send(400, {"error": "bad boss"})
                with lock:
                    ok = boss_tick(b, body["i"], bool(body.get("on")))
                return self.send(200, {"ok": ok})
            return self.send(404, {"error": "not found"})

    try:
        srv = http.server.ThreadingHTTPServer(("0.0.0.0" if lan else "127.0.0.1", port), Handler)
    except OSError:
        die(f"Port {port} is busy. Is the world already open? Try ./quest world --port {port + 1}")
    url = f"http://127.0.0.1:{port}/"
    print(f"\n  🗺️  {B('The world is open')} at {CYN(url)}")
    print(DIM("  Drag or two-finger swipe to pan · scroll/pinch to zoom · click anything."))
    if lan:
        print(f"  📲 {B('iPad mode on.')} Click the 📲 button on the map and scan its QR code with your iPad")
        print(DIM(f"     (same Wi-Fi; reader address http://{ip}:{port}/read). Only devices with the code get in;"))
        print(DIM("     traffic isn't encrypted, so use it on your home network. macOS may ask to allow incoming"))
        print(DIM("     connections for Python: click Allow."))
    else:
        print(DIM("  Want to read on your iPad? Restart with: ./quest world --ipad"))
    print(DIM("  Keep this terminal open while you play; Ctrl-C closes the world.\n"))
    if auto_open:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  👋 World closed. Your progress is saved.")
    finally:
        srv.server_close()


