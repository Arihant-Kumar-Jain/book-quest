def first_unread(book, k, ch=None):
    chs = [ch] if ch is not None else book.required
    for n in chs:
        for q in book.ch[n]["reading"]:
            if q["id"] not in k.read:
                return book.ch[n], q
    return None


def next_read(book, save, k):
    """Continue in the chapter you last read from; otherwise the earliest unread quest."""
    last = [e for e in save["events"] if e["t"] == "read" and not is_side_id(e["id"])]
    if last:
        ch = int(last[-1]["id"].split(".")[0])
        got = first_unread(book, k, ch) if ch in book.ch else None
        if got:
            return got
    return first_unread(book, k)


