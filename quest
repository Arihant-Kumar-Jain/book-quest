        kc = http.client.HTTPConnection("127.0.0.1", port)
        cur = {}
        while True:
            line = r_.fp.readline()
            if not line:
                return
            line = line.decode().rstrip("\n")
            if line.startswith("event:"):
                cur["e"] = line[6:].strip()
            elif line.startswith("data:"):
                cur["d"] = json.loads(line[5:])
            elif line == "" and cur:
                t_ev = time.perf_counter()
                e, d = cur.get("e"), cur.get("d")
                cur = {}
                if e == "hello":
                    ready.set()
                elif e == "nav":
                    kc.request("POST", "/api/ack", json.dumps({"seq": d["seq"]}),
                               {"Content-Type": "application/json", "X-Quest-Token": token})
                    kc.getresponse().read()
                    kc.request("GET", f"/page/{d['key']}/{d['page']}?w={W}&h={H}&v=b&ahead=0")
                    kc.getresponse().read()
                    got.put((d["seq"], t_ev, time.perf_counter(), bool(d.get("preview"))))
    th.Thread(target=reader, daemon=True).start()
    ready.wait(10)
    pushes = defaultdict(list)
    for i in range(30 if quick else 100):
        warm = i % 2 == 0
        pg = rnd.randint(1, n)
        if warm:
            _post(c, token, "/api/warm", {"key": "main", "page": pg})
            time.sleep(0.15)                              # the hover comes a moment before the click
        t0 = time.perf_counter()
        st_, body = _post(c, token, "/api/pdf", {"key": "main", "page": pg, "bench": True})
        t1 = time.perf_counter()
        if st_ != 200:
            continue
        seq, t_ev, t_full, had_pv = got.get(timeout=10)
        tag = "warm" if warm else "cold"
        pushes[f"{tag}_receive"].append((t_ev - t0) * 1000)
        pushes[f"{tag}_ack"].append((t1 - t0) * 1000)
        pushes[f"{tag}_sharp_page"].append((t_full - t0) * 1000)
        pushes[f"{tag}_preview_inline"].append(1.0 if had_pv else 0.0)
    res["push"] = {k_: (_stats(v) if not k_.endswith("inline") else sum(v) / max(1, len(v))) for k_, v in pushes.items()}

    # 5. throughput: 8 clients fetching drawn pages as fast as they can
    stop_at = time.perf_counter() + (2 if quick else 5)
    counts, nbytes = [0] * 8, [0] * 8

    def hammer(i):
        hc = http.client.HTTPConnection("127.0.0.1", port)
        while time.perf_counter() < stop_at:
            _, b = _get(hc, f"/page/main/{pages[(i * 7 + counts[i]) % 10]}?w={W}&h={H}&v=b&ahead=0")
            counts[i] += 1
            nbytes[i] += len(b)
    t0 = time.perf_counter()
    ts = [th.Thread(target=hammer, args=(i,)) for i in range(8)]
    [t_.start() for t_ in ts]
    [t_.join() for t_ in ts]
    el = time.perf_counter() - t0
    res["throughput"] = {"clients": 8, "requests_per_s": sum(counts) / el, "mb_per_s": sum(nbytes) / el / 1e6}

    # 6. the whole book, drawn in the background at the reader's size
    fill_box = (W - 16, H - 16)
    t0 = time.perf_counter()
    _get(c, f"/page/main/1?w={fill_box[0]}&h={fill_box[1]}&v=b")
    filled, deadline = 0, time.time() + (60 if quick else 300)
    while time.time() < deadline:
        filled = sum(1 for d_ in PAGE_CACHE.glob(f"*/{fill_box[0]}x{fill_box[1]}-auto") for f in d_.iterdir() if f.suffix in (".png", ".jpg"))
        if filled >= n:
            break
        time.sleep(0.5)
    el = time.perf_counter() - t0
    disk = sum(f.stat().st_size for d_ in PAGE_CACHE.glob(f"*/{fill_box[0]}x{fill_box[1]}-auto") for f in d_.iterdir())
    res["whole_book"] = {"pages": n, "filled": filled, "seconds": el, "pages_per_s": filled / el if el else None, "disk_mb": disk / 1e6}
    try:
        rss = int(subprocess.run(["ps", "-o", "rss=", "-p", str(proc.pid)], capture_output=True, text=True).stdout.strip() or 0)
        helpers = subprocess.run(["pgrep", "-P", str(proc.pid)], capture_output=True, text=True).stdout.split()
        hrss = sum(int(subprocess.run(["ps", "-o", "rss=", "-p", h], capture_output=True, text=True).stdout.strip() or 0) for h in helpers)
        res["memory_mb"] = {"server": rss / 1024, "helpers": hrss / 1024, "helper_count": len(helpers)}
    except (OSError, ValueError):
        pass
    stop(proc)

    # 7. after a restart: pages come back from the disk cache
    proc = start()
    c = http.client.HTTPConnection("127.0.0.1", port)
    disk_hits = [_get(c, f"/page/main/{pg}?w={W}&h={H}&v=b&ahead=0")[0] for pg in pages]
    res["disk_hit_after_restart"] = _stats(disk_hits)
    stop(proc)
    for d_ in list(PAGE_CACHE.glob(f"*/{W}x{H}-*")) + list(PAGE_CACHE.glob(f"*/{fill_box[0]}x{fill_box[1]}-*")) + \
            list(PAGE_CACHE.glob(f"*/{W // 4}x{H // 4}-*")):
        shutil.rmtree(d_, ignore_errors=True)
    return res


def _get(c, path, gzip_=False, raw=False, mime=False):
    import time
    hdr = {"Accept-Encoding": "gzip"} if gzip_ else {}
    t = time.perf_counter()
    c.request("GET", path, headers=hdr)
    r = c.getresponse()
    body = r.read()
    ms = (time.perf_counter() - t) * 1000
    if gzip_ and not raw and r.getheader("Content-Encoding") == "gzip":
        import gzip
        body = gzip.decompress(body)
    return (ms, body, r.getheader("Content-Type")) if mime else (ms, body)


def _post(c, token, path, body):
    c.request("POST", path, json.dumps(body), {"Content-Type": "application/json", "X-Quest-Token": token})
    r = c.getresponse()
    return r.status, r.read()


def bench_device():
    """Timings readers reported from real devices (tap "Mac" in the reader to watch them live)."""
    if not PERF_FILE.exists():
        return {}
    try:
        data = json.loads(PERF_FILE.read_text())
    except ValueError:
        return {}
    groups = defaultdict(list)
    for e in data:
        if e.get("kind") in DEVICE_KINDS and isinstance(e.get("ms"), (int, float)):
            groups[(e.get("device", "?"), e["kind"])].append(e["ms"])
    out = defaultdict(dict)
    for (dev, kind), xs in groups.items():
        out[dev][kind] = _stats(xs)
    return dict(out)


