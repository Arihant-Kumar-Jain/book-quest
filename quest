_ROOT_PREFIX = str(ROOT) + os.sep


def rel(p):
    s = str(p)
    if s.startswith(_ROOT_PREFIX) and "/.." not in s:
        return s[len(_ROOT_PREFIX):]          # already under ROOT: no need to ask the file system
    try:
        return str(Path(p).resolve().relative_to(ROOT))
    except ValueError:
        return s


def wrap(text, indent, width=78):
    return textwrap.fill(text, width=width, initial_indent=indent, subsequent_indent=indent)


def now():
    fake = os.environ.get("QUEST_NOW")  # handy for testing streaks
    return datetime.fromisoformat(fake) if fake else datetime.now().replace(microsecond=0)


def iso(d):
    return d.isoformat(timespec="seconds")


def stars(n):
    return "★" * n + " " * (3 - n)


def hm(minutes):
    h, m = divmod(int(minutes), 60)
    return f"{h}h {m:02d}m" if h else f"{m}m"


def threshold(level):
    k = level - 1
    return 60 * k * k + 180 * k   # Lv 20 ≈ 25k XP ≈ the whole book plus steady habits


def level_for(xp):
    lv = 1
    while threshold(lv + 1) <= xp:
        lv += 1
    return lv


def title_for(lv):
    titles = _BOOK.titles if _BOOK else TITLES
    return titles[lv - 1] if lv <= len(titles) else f"Legend ★{lv - len(titles)}"


def roman(n):
    out = ""
    for v, s in ((1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
                 (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")):
        while n >= v:
            out, n = out + s, n - v
    return out


