RENDER_HDR = QDIR / "render_fast.h"                # C + ARM NEON hot loops, imported by render.swift
RENDER_BIN = QDIR / ".bin" / "quest-render"
PERF_FILE = QDIR / "perf.json"                  # timings reported by readers (git-ignored)
PERF_KEYS = {"kind", "ms", "at", "mode", "dom_ms", "preview", "ttfb", "kb", "cached", "px"}
PAGE_CACHE = QDIR / ".cache" / "pages"          # drawn pages, kept across restarts (git-ignored)
PAGE_CACHE_MAX = int(os.environ.get("QUEST_CACHE_MB", "1024")) << 20


class PageRenderer:
    """Turns PDF pages into images with macOS PDFKit, through the small Swift helper in .quest/render.swift
    (built once with swiftc). The iPad then shows plain images: no PDF.js, no big download, no internet.
    Text pages arrive as 16-shade PNGs about a quarter the size of a JPEG; pages stay in memory and on disk
    (so a restart doesn't redraw them), the next ones are drawn ahead, and two helpers are always kept free
    for whatever you're looking at right now."""

    def __init__(self, workers=4):
        import queue
        import threading
        from collections import OrderedDict
        from concurrent.futures import ThreadPoolExecutor
        self.ready, self.ok, self.why = threading.Event(), False, ""
        self.idle, self.spawned, self.workers = queue.LifoQueue(), 0, workers
        self.mu = threading.Lock()
        self.cache, self.cache_bytes, self.cache_max = OrderedDict(), 0, 384 << 20
        self.inflight, self.infos, self.gen = {}, {}, 0
        self.interactive, self.fill_job = 0, None
        self.ahead = ThreadPoolExecutor(max_workers=max(1, workers - 3), thread_name_prefix="prerender")
        threading.Thread(target=self._build, daemon=True).start()
        threading.Thread(target=self.prune, daemon=True).start()

    def _build(self):
        try:
            if sys.platform != "darwin" or not shutil.which("swiftc"):
                self.why = "the native renderer needs macOS with the Xcode command line tools"
                return
            newest = max(RENDER_SRC.stat().st_mtime, RENDER_HDR.stat().st_mtime)
            if not RENDER_BIN.exists() or RENDER_BIN.stat().st_mtime < newest:
                RENDER_BIN.parent.mkdir(exist_ok=True)
                tmp = RENDER_BIN.with_name(RENDER_BIN.name + ".tmp")
                r = subprocess.run(["swiftc", "-O", "-import-objc-header", str(RENDER_HDR), "-o", str(tmp), str(RENDER_SRC)],
                                   capture_output=True, text=True, timeout=600)
                if r.returncode:
                    self.why = "swiftc failed: " + r.stderr.strip()[-300:]
                    return
                os.replace(tmp, RENDER_BIN)
            self.ok = True
        except (OSError, subprocess.SubprocessError) as e:
            self.why = str(e)
        finally:
            self.ready.set()

    def available(self, wait=120):
        self.ready.wait(wait)
        return self.ok

    def _take(self):
        import queue
        try:
            return self.idle.get_nowait()
        except queue.Empty:
            pass
        with self.mu:
            if self.spawned < self.workers:
                self.spawned += 1
                try:
                    return subprocess.Popen([str(RENDER_BIN)], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                            stderr=subprocess.DEVNULL)
                except OSError:
                    self.spawned -= 1
                    raise
        return self.idle.get()

    def _call(self, line):
        """One request to a helper → (body, mime type)."""
        for attempt in (0, 1):
            p = self._take()
            try:
                p.stdin.write(line.encode("utf-8") + b"\n")
                p.stdin.flush()
                head = p.stdout.readline().decode().rstrip("\n").split("\t")
                body = p.stdout.read(int(head[1]))
            except (OSError, ValueError, IndexError):
                p.kill()
                with self.mu:
                    self.spawned -= 1
                if attempt:
                    raise OSError("the page renderer stopped")
                continue
            self.idle.put(p)
            if head[0] != "OK":
                raise ValueError(body.decode("utf-8", "replace"))
            return body, (head[2] if len(head) > 2 else "application/octet-stream")

    @staticmethod
    def version(path):
        st = path.stat()
        return f"{st.st_mtime_ns:x}{st.st_size:x}"[-12:]

    def info(self, path):
        """Page count, printed page labels and page sizes in points, cached per PDF version."""
        v = self.version(path)
        if (path, v) not in self.infos:
            if "\t" in str(path) or "\n" in str(path):
                raise ValueError("unsupported file name")
            self.infos[(path, v)] = dict(json.loads(self._call(f"I\t{path}")[0]), v=v)
        return self.infos[(path, v)]

    def peek(self, path, page, w, h, kind="auto"):
        with self.mu:
            return self.cache.get((str(path), self.version(path), page, w, h, kind))

    # ── disk cache: .quest/.cache/pages/<book>-<version>/<W>x<H>-<kind>/<page>.png|jpg ──
    def _disk_dir(self, path, w, h, kind):
        tag = hashlib.sha1(str(path).encode()).hexdigest()[:8]
        return PAGE_CACHE / f"{tag}-{self.version(path)}" / f"{w}x{h}-{kind}"

    def on_disk(self, path, page, w, h, kind="auto"):
        d = self._disk_dir(path, w, h, kind)
        return (d / f"{page}.png").exists() or (d / f"{page}.jpg").exists()

    def _disk_get(self, path, page, w, h, kind):
        d = self._disk_dir(path, w, h, kind)
        for ext, mime in (("png", "image/png"), ("jpg", "image/jpeg")):
            try:
                return (d / f"{page}.{ext}").read_bytes(), mime
            except OSError:
                pass
        return None

    def _disk_put(self, path, page, w, h, kind, data, mime):
        d = self._disk_dir(path, w, h, kind)
        try:
            d.mkdir(parents=True, exist_ok=True)
            tmp = d / f".{page}.{os.getpid()}.{id(data)}.tmp"
            tmp.write_bytes(data)
            os.replace(tmp, d / f"{page}.{'png' if mime == 'image/png' else 'jpg'}")
        except OSError:
            pass

    def prune(self):
        """Keep the disk cache under its cap (1 GB by default), dropping the least recently used sizes first."""
        try:
            dirs = []
            for d in PAGE_CACHE.glob("*/*"):
                if d.is_dir():
                    files = [f for f in d.iterdir() if f.is_file()]
                    dirs.append((d.stat().st_mtime, d, sum(f.stat().st_size for f in files)))
            total = sum(x[2] for x in dirs)
            for _, d, size in sorted(dirs, key=lambda x: x[0]):
                if total <= PAGE_CACHE_MAX:
                    break
                shutil.rmtree(d, ignore_errors=True)
                total -= size
            for top in PAGE_CACHE.glob("*"):
                if top.is_dir() and not any(top.iterdir()):
                    top.rmdir()
        except OSError:
            pass

    def render(self, path, page, w, h, kind="auto", bg=False):
        """→ (image bytes, mime type). kind "auto" is the sharp page, "preview" a small quick one.
        bg=True marks background work, which steps aside while anything you're looking at is drawn."""
        from concurrent.futures import Future
        key = (str(path), self.version(path), page, w, h, kind)
        with self.mu:
            if key in self.cache:
                self.cache.move_to_end(key)
                return self.cache[key]
            fut = self.inflight.get(key)
            mine = fut is None
            if mine:
                fut = self.inflight[key] = Future()
        if not mine:
            return fut.result()
        if not bg:
            with self.mu:
                self.interactive += 1
        try:
            data = self._disk_get(path, page, w, h, kind)
            if data is None:
                # h=0: fit the width. Pages someone is waiting for use 8 cores; background work uses 1
                data = self._call(f"R\t{path}\t{page}\t{w}\t{h or 8192}\t{kind}\t{1 if bg else 8}")
                self._disk_put(path, page, w, h, kind, *data)
        except Exception as e:
            with self.mu:
                self.inflight.pop(key, None)
                self.interactive -= 0 if bg else 1
            fut.set_exception(e)
            raise
        with self.mu:
            self.inflight.pop(key, None)
            self.interactive -= 0 if bg else 1
            self.cache[key] = data
            self.cache_bytes += len(data[0])
            while self.cache_bytes > self.cache_max and self.cache:
                self.cache_bytes -= len(self.cache.popitem(last=False)[1][0])
        fut.set_result(data)
        return data

    def warm(self, path):
        """Start every helper now and let each open the book, so no request ever pays for a cold start."""
        if not self.available():
            return
        procs = []
        try:
            for _ in range(self.workers):
                procs.append(self._take())
            for proc in procs:
                proc.stdin.write(f"R\t{path}\t1\t64\t64\tpreview\n".encode())
                proc.stdin.flush()
            for proc in procs:
                head = proc.stdout.readline().decode().split("\t")
                proc.stdout.read(int(head[1]))
        except (OSError, ValueError, IndexError):
            pass
        finally:
            for proc in procs:
                self.idle.put(proc)

    def prefetch(self, path, pages, w, h, kind="auto"):
        """Draw pages in the background so they are already in memory when the iPad asks.
        Jobs that are still queued when you've moved on to a different page are dropped."""
        if self.ok:
            with self.mu:
                self.gen += 1
                gen = self.gen
            self.ahead.submit(self._ahead, path, pages, w, h, kind, gen)

    def _ahead(self, path, pages, w, h, kind, gen):
        try:
            n = self.info(path)["n"]
            for p in pages:
                if self.gen - gen > 3:
                    return                         # stale: the reader is somewhere else now
                if 1 <= p <= n:
                    self.render(path, p, w, h, kind, bg=True)
        except (OSError, ValueError):
            pass

    def fill(self, path, center, w, h):
        """Quietly draw the whole book at the reader's size, nearest pages first, on one helper, so a jump
        to any page is just a transfer. The newest focus wins; anything you're looking at goes first."""
        if not self.ok:
            return
        import threading
        with self.mu:
            if self.fill_job and self.fill_job[2:] == (w, h) and self.fill_job[0] == str(path):
                fresh = False
            else:
                fresh = True
            self.fill_job = (str(path), center, w, h)
            start = not getattr(self, "filler", None)
        if fresh:                                  # mark this size as recently used, for prune()
            try:
                os.utime(self._disk_dir(path, w, h, "auto"))
            except OSError:
                pass
            if start:
                self.filler = threading.Thread(target=self._filler, daemon=True, name="filler")
        if start:
            self.filler.start()

    def _filler(self):
        import time
        while True:
            job = self.fill_job
            path, center, w, h = job
            try:
                n = self.info(Path(path))["n"]
            except (OSError, ValueError):
                time.sleep(1)
                continue
            for p in sorted(range(1, n + 1), key=lambda x: (abs(x - center) * (1 if x >= center else 1.5))):
                if self.fill_job != job:
                    break
                if self.peek(Path(path), p, w, h) or self.on_disk(Path(path), p, w, h):
                    continue
                while self.interactive:
                    time.sleep(0.005)
                try:
                    self.render(Path(path), p, w, h, bg=True)
                except (OSError, ValueError):
                    pass
            while self.fill_job == job:
                time.sleep(0.2)


def cmd_world(book, args):
    import base64
    import ipaddress
    import gzip
    import http.server
    import queue
    import secrets
    import threading
    import time
    import webbrowser
    from http.cookies import SimpleCookie
    from urllib.parse import parse_qs, urlparse
    port, auto_open = WORLD_PORT, "--no-open" not in args
    lan = "--ipad" in args or "--lan" in args
    if "--port" in args:
        try:
            port = int(args[args.index("--port") + 1])
        except (IndexError, ValueError):
            die("Usage: ./quest world [--ipad] [--port N] [--no-open]")
    for f in (WORLD_HTML, READER_HTML):
        if not f.exists():
            die(f"Missing {rel(f)}.")
    token = secrets.token_hex(16)
    pair = pair_key() if lan else secrets.token_urlsafe(12)
    ip = lan_ip() if lan else "127.0.0.1"
    host_alt = local_hostname() if lan else None
    lock = threading.Lock()
    perf_lock = threading.Lock()
    ink_lock = threading.Lock()
    me = str(Path(__file__).resolve())

    def record_perf(events, meta):
        """Append timing samples (from a reader, or the Mac's own push round trips) to .quest/perf.json."""
        clean = []
        for e in events[:2000]:
            if isinstance(e, dict) and isinstance(e.get("kind"), str) and isinstance(e.get("ms"), (int, float)):
                row = {k: (v[:60] if isinstance(v, str) else v) for k, v in e.items()
                       if k in PERF_KEYS and isinstance(v, (int, float, str, bool))}
                row.update(meta)
                clean.append(row)
        with perf_lock:
            try:
                data = json.loads(PERF_FILE.read_text()) if PERF_FILE.exists() else []
            except ValueError:
                data = []
            PERF_FILE.write_text(json.dumps((data + clean)[-20000:]))
        return len(clean)
    sys.setswitchinterval(0.0005)        # hand the GIL over quickly, so a push never waits behind busy threads
    renderer = PageRenderer()
    # Live link to open readers: each one holds a Server-Sent Events stream, "Open the book" pushes a
    # page down every stream at once, and the reader acknowledges it so the Mac knows it arrived.
    live = threading.Condition()
    nav = {"seq": 0, "acked": 0, "last": None}
    radio = {"until": 0.0}  # while set, streams send a tiny keep-alive every 30 ms so the iPad's Wi-Fi stays awake
    readers = {}            # stream id -> queue of messages to send
    view = {}               # last image size a reader asked for, so a sent page can be drawn ahead

    def pdf_for(key):
        if key in (None, "", "main"):
            return book.pdf()
        return book.side_pdf(book.side[key]) if key in book.side else None

    def reader_connected():
        return bool(readers)

    def warm_up():
        """Index every book once at startup, so opening or switching books on the iPad is instant."""
        if not renderer.available():
            return
        if pdf_for("main"):
            renderer.warm(pdf_for("main"))
        for key in ["main"] + list(book.side):
            p = pdf_for(key)
            try:
                if p and p.exists():
                    renderer.info(p)
            except (OSError, ValueError):
                pass
    threading.Thread(target=warm_up, daemon=True).start()

    def preview_size():
        return max(16, view["w"] // 4), view["h"] // 4

    def publish(event, msg):
        with live:
            for box in readers.values():
                box.put((event, msg))

    def num(q, name, lo, hi, default=0):
        try:
            return max(lo, min(hi, int((q.get(name) or [default])[0])))
        except ValueError:
            return default

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"       # keep-alive: page images reuse one connection
        disable_nagle_algorithm = True       # small pushes leave immediately instead of waiting for ACKs
        timeout = 120
        cookie = None

        def log_message(self, *a):
            pass

        def is_local(self):
            return self.client_address[0] in LOCAL_IPS

        def host_ok(self):
            """Only answer requests addressed to an IP, localhost or a Bonjour .local name. A web page that points its
            own domain at 127.0.0.1 (DNS rebinding) would send its domain as Host, and gets turned away here."""
            h = (self.headers.get("Host") or "").strip().lower()
            name = h[1:h.find("]")] if h.startswith("[") else h.rsplit(":", 1)[0]
            if name == "localhost" or name.endswith(".local"):
                return True
            try:
                ipaddress.ip_address(name)
                return True
            except ValueError:
                return False

        def end_headers(self):
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
            super().end_headers()

        def allowed(self, q):
            if self.is_local():
                return True
            if not lan:
                return False
            c = SimpleCookie(self.headers.get("Cookie", ""))
            k = (q.get("key") or [""])[0]
            if ("qk" in c and secrets.compare_digest(c["qk"].value, pair)) or (k and secrets.compare_digest(k, pair)):
                # (re)issue the pairing cookie: it renews every time the iPad connects, so it only lapses after
                # a month without use. HttpOnly + SameSite=Strict: page scripts can't read it, other sites can't send it.
                self.cookie = f"qk={pair}; Path=/; HttpOnly; SameSite=Strict; Max-Age=2592000"
                return True
            return False

        def send(self, code, body, ctype="application/json", cache="no-store"):
            data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode("utf-8")
            zipped = len(data) > 1400 and ctype.startswith(("application/json", "text/")) and \
                "gzip" in (self.headers.get("Accept-Encoding") or "")
            if zipped:
                data = gzip.compress(data, 1)          # level 1: 110 KB of quest state → ~29 KB in ~1 ms
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", cache)
            if zipped:
                self.send_header("Content-Encoding", "gzip")
                self.send_header("Vary", "Accept-Encoding")
            if self.cookie:
                self.send_header("Set-Cookie", self.cookie)
            self.end_headers()
            self.wfile.write(data)

        def send_pdf(self, p):
            """The whole PDF, or the byte range PDF.js asks for (the fallback reader loads pages on demand)."""
            size = p.stat().st_size
            start, end, code = 0, size - 1, 200
            m = re.fullmatch(r"bytes=(\d*)-(\d*)", (self.headers.get("Range") or "").strip())
            if m and (m.group(1) or m.group(2)):
                if m.group(1):
                    start, end = int(m.group(1)), min(int(m.group(2) or size - 1), size - 1)
                else:
                    start = max(0, size - int(m.group(2)))
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                code = 206
            self.send_response(code)
            self.send_header("Content-Type", "application/pdf")
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            if code == 206:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.send_header("Cache-Control", "private, max-age=86400")
            if self.cookie:
                self.send_header("Set-Cookie", self.cookie)
            self.end_headers()
            try:
                with p.open("rb") as fh:
                    fh.seek(start)
                    left = end - start + 1
                    while left > 0:
                        chunk = fh.read(min(left, 256 * 1024))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True

        def events(self, q):
            """Server-Sent Events stream to one reader: pages sent from the Mac arrive the moment you click."""
            if q.get("w"):
                view.update(w=num(q, "w", 16, 4096), h=num(q, "h", 0, 4096))
            try:
                last = int(self.headers.get("Last-Event-ID") or (q.get("last") or [""])[0])
            except ValueError:
                last = None
            box = queue.Queue()
            with live:
                if len(readers) >= 16:
                    return self.send(503, {"error": "too many readers connected"})
                readers[id(box)] = box
                seq, replay = nav["seq"], nav["last"]
            try:
                self.close_connection = True
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                if self.cookie:
                    self.send_header("Set-Cookie", self.cookie)
                self.end_headers()
                out = f"retry: 1000\nid: {seq}\nevent: hello\ndata: {json.dumps({'seq': seq})}\n\n"
                if replay and last is not None and replay["seq"] > last:
                    out += f"id: {replay['seq']}\nevent: nav\ndata: {json.dumps(replay)}\n\n"
                self.wfile.write(out.encode())
                while True:
                    # An idle iPad naps its Wi-Fi radio between beacons (~100 ms), so a push that lands mid-nap
                    # waits. Right after a hint (the Mac is about to click), keep-alives every 30 ms keep it awake.
                    awake = radio["until"] > time.monotonic()
                    try:
                        msg = box.get(timeout=0.03 if awake else 10)
                    except queue.Empty:
                        self.wfile.write(b":\n\n" if awake else b": ping\n\n")
                        continue
                    if msg is None:
                        return
                    event, msg = msg
                    self.wfile.write(f"id: {msg['seq']}\nevent: {event}\ndata: {json.dumps(msg)}\n\n".encode())
            except OSError:
                pass
            finally:
                with live:
                    readers.pop(id(box), None)

        def page_image(self, m, q):
            key, pg = m.group(1), int(m.group(2))
            kind = "preview" if q.get("lq") else "auto"
            p = pdf_for(key)
            if not p or not p.exists():
                return self.send(404, {"error": "no such book here"})
            if not renderer.available(0):
                return self.send(503, {"error": "native renderer not available"})
            w, h = num(q, "w", 16, 4096, 1024), num(q, "h", 0, 4096)
            try:
                data, mime = renderer.render(p, pg, w, h, kind)
            except (OSError, ValueError) as e:
                return self.send(404, {"error": str(e)})
            self.send(200, data, mime, "private, max-age=31536000, immutable")
            if kind == "auto" and (q.get("ahead") or ["1"])[0] != "0":
                renderer.prefetch(p, (pg + 1, pg + 2, pg + 3, pg - 1), w, h)
                renderer.fill(p, pg, w, h)

        def page(self, f):
            html = f.read_text(encoding="utf-8").replace("__QUEST_TOKEN__", token)
            return self.send(200, html.encode("utf-8"), "text/html; charset=utf-8")

        def do_GET(self):
            u = urlparse(self.path)
            q, path = parse_qs(u.query), u.path
            if not self.host_ok():
                return self.send(421, {"error": "unexpected Host header"})
            if not self.allowed(q):
                return self.send(403, "<meta name=viewport content='width=device-width'><body style='font:18px -apple-system;"
                                      "padding:40px;background:#0a0d16;color:#efe6d2'><h2>🔒 Locked</h2><p>Scan the QR code from "
                                      "the 📲 button on your Mac's world map to connect this device.</p>".encode("utf-8"),
                                 "text/html; charset=utf-8")
            if path in ("/", "/index.html"):
                return self.page(WORLD_HTML)
            if path == "/read":
                return self.page(READER_HTML)
            if path == "/manifest.webmanifest":                # makes "Add to Home Screen" a real app
                return self.send(200, {"name": f"Quest Reader · {getattr(book, 'short', 'Book')}", "short_name": "Quest Reader",
                                       "start_url": "/read", "scope": "/", "display": "standalone",
                                       "background_color": "#0a0d16", "theme_color": "#0a0d16",
                                       "icons": [{"src": "/icon-180.png", "sizes": "180x180", "type": "image/png"},
