def side_next(book, k, key, ch=None):
    qs = [q for sc in book.side[key]["chapters"] if ch is None or sc["num"] == ch
          for q in sc["reading"] if q["id"] not in k.read]
    req = [q for q in qs if not q["optional"]]
    return (req or qs or [None])[0]


def side_line(book, k):
    active = [s for s in book.side.values() if k.side[s["key"]].started and not k.side[s["key"]].finished]
    if active:
        s = max(active, key=lambda s: k.side[s["key"]].last)
        q = side_next(book, k, s["key"])
        if q:
            print(f"    🗺️  {s['short']}: {q['id']} {q['title'][:48]}  {DIM(pages_of(q))}  {YEL('+' + str(q['xp']))}  → ./quest read {s['key']}")
            return
        lab = next((x for x in s["labs"] if x["id"] not in k.exd), None)
        if lab:
            print(f"    🧪 {s['short']} lab {lab['id']}: {lab['title']}  {YEL('+' + str(Book.ex_xp(lab)))}  → ./quest done {lab['id']} \"what happened\"")
            return
    if k.current is not None:
        fits = sorted((s for s in book.side.values() if k.current in s["pairs"] and not k.side[s["key"]].started),
                      key=lambda s: len(s["pairs"]))
        if fits:
            print(DIM(f"    🗺️  Optional side quest for this chapter: {fits[0]['short']} → ./quest side {fits[0]['key']}"))


def parse_read_targets(book, save, k, args):
    k = SimpleNamespace(read=dict(k.read))   # local copy: "read 2 2" picks two different quests

    def take(i):
        k.read[i] = "picked"
        return i
    if not args:
        nr = next_read(book, save, k)
        if not nr:
            die("Nothing left to read. Wow.")
        return [nr[1]["id"]]
    ids = []
    for a in args:
        a = a.lower()
        m_all = re.fullmatch(r"(\d+)\.(all|\*)", a)
        sm = re.fullmatch(r"([a-z]+)(?:\.(\d+))?(?:\.(all|\*))?", a)
        if a in book.reading:
            ids.append(a)
        elif m_all and int(m_all.group(1)) in book.ch:
            ids += [q["id"] for q in book.ch[int(m_all.group(1))]["reading"]]
        elif a.isdigit() and int(a) in book.ch:
            got = first_unread(book, k, int(a))
            if not got:
                print(DIM(f"  Chapter {a}: all reading done."))
                continue
            ids.append(take(got[1]["id"]))
        elif sm and sm.group(1) in book.side:
            key, chn, every = sm.group(1), sm.group(2), sm.group(3)
            s = book.side[key]
            if chn is not None and int(chn) not in {sc["num"] for sc in s["chapters"]}:
                die(f"{s['short']} has no chapter {chn}. See ./quest side {key}")
            if every:
                ids += [q["id"] for sc in s["chapters"] if chn is None or sc["num"] == int(chn) for q in sc["reading"]]
            else:
                q = side_next(book, k, key, int(chn) if chn is not None else None)
                if not q:
                    print(DIM(f"  {s['short']}: nothing left to read there."))
                    continue
                ids.append(take(q["id"]))
        else:
            die(f"Unknown reading quest '{a}'. Examples: 2.3 · 2 (next in ch 2) · 2.all · dbg (next in a side book) · dbg.2.3")
    return ids


def cmd_read(book, args):
    save0 = load_save()
    k0 = compute(book, save0)
    ids = parse_read_targets(book, save0, k0, args)

    def fn(save):
        for i in ids:
            _, q = book.reading[i]
            if i in k0.read:
                print(DIM(f"  {i} already read ({k0.read[i][:10]})."))
                continue
            save["events"].append({"t": "read", "id": i, "at": iso(now())})
            k0.read[i] = iso(now())
            print(f"  📖 {GRN('✔')} {i} {q['title']}  {YEL('+' + str(q['xp']) + ' XP')}")

    save, k = mutate(book, fn)
    if ids and is_side_id(ids[-1]):
        key = ids[-1].split(".")[0]
        q = side_next(book, k, key)
        if q:
            print(DIM(f"  next in {book.side[key]['short']}: {q['id']} {q['title']} ({pages_of(q)})"))
    else:
        nr = next_read(book, save, k)
        if nr:
            print(DIM(f"  next: {nr[1]['id']} {nr[1]['title']} ({pages_of(nr[1])})"))
    mini(k)


def mini(k):
