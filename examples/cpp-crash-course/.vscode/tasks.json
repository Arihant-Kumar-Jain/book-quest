{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build active file",
      "type": "shell",
      "command": "mkdir -p .build && ${env:CXX} -std=c++20 -Wall -Wextra -g '${file}' -o '.build/${fileBasenameNoExtension}'",
      "osx": { "command": "mkdir -p .build && clang++ -std=c++20 -Wall -Wextra -g '${file}' -o '.build/${fileBasenameNoExtension}'" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
